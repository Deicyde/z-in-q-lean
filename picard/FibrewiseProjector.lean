import PrymFactor
import UniformDescent

/-! The rational idempotent associated to a splitting cochain on a finite group.
Its image is the number field generated by the cochain values, as a rational
representation of the twisted left shifts. -/

namespace ZOverQ.Qualitative.FibrewiseProjector

open UniformDescent

noncomputable section

variable {G : Type} [Group G]

/-- The action of a regular basis vector on the quotient is multiplication
by its cochain value in the coefficient field. -/
def fieldAction (b : G → Qbarˣ) (g : G) :
    coefficientField b ≃ₗ[ℚ] coefficientField b where
  toFun x := coefficientValue b g * x
  invFun x := (↑((coefficientUnit b g)⁻¹) : coefficientField b) * x
  left_inv x := by
    change (↑((coefficientUnit b g)⁻¹) : coefficientField b) *
      (↑(coefficientUnit b g) * x) = x
    rw [← mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_mul]
  right_inv x := by
    change (↑(coefficientUnit b g) : coefficientField b) *
      (↑((coefficientUnit b g)⁻¹) * x) = x
    rw [← mul_assoc, ← Units.val_mul, mul_inv_cancel, Units.val_one, one_mul]
  map_add' x y := mul_add _ x y
  map_smul' r x := by
    change coefficientValue b g * (r • x) = r • (coefficientValue b g * x)
    rw [mul_smul_comm]

theorem fieldAction_mul (b : G → Qbarˣ) (c : G × G → ℚˣ)
    (hb : ∀ g h, rationalUnit (c (g,h)) = b g * b h / b (g*h))
    (g h : G) (x : coefficientField b) :
    fieldAction b g (fieldAction b h x) = (c (g,h) : ℚ) • fieldAction b (g*h) x := by
  change coefficientValue b g * (coefficientValue b h * x) =
    (c (g,h) : ℚ) • (coefficientValue b (g*h) * x)
  rw [← mul_assoc, coefficientValue_mul b c hb, smul_mul_assoc]

/-- A rational factor set which admits a splitting cochain is a cocycle. -/
theorem cocycle_of_splitting (b : G → Qbarˣ) (c : G × G → ℚˣ)
    (hb : ∀ g h, rationalUnit (c (g,h)) = b g * b h / b (g*h)) (g h k : G) :
    c (g*h,k) * c (g,h) = c (h,k) * c (g,h*k) := by
  have hinj : Function.Injective rationalUnit := fun _ _ he =>
    Units.ext ((algebraMap ℚ Qbar).injective (congrArg Units.val he))
  apply hinj
  simp only [map_mul, hb, mul_assoc g h k]
  simp only [div_eq_mul_inv]
  let w := b g * b h * b k * (b (g*h*k))⁻¹
  calc
    _ = w * (b (g*h) * (b (g*h))⁻¹) := by dsimp [w]; ac_rfl
    _ = w * (b (h*k) * (b (h*k))⁻¹) := by rw [mul_inv_cancel, mul_inv_cancel]
    _ = _ := by dsimp [w]; ac_rfl

variable [Fintype G]

/-- The twisted regular representation contains the coefficient field as
the image of a rational equivariant idempotent. On that image the
identification is the original evaluation map. -/
theorem exists_projector (b : G → Qbarˣ) (c : G × G → ℚˣ)
    (hb : ∀ g h, rationalUnit (c (g,h)) = b g * b h / b (g*h)) :
    ∃ p : Module.End ℚ (G → ℚ), p.comp p = p ∧
      (∀ g x, twistedLeftShift c g (p x) = p (twistedLeftShift c g x)) ∧
      ∃ e : LinearMap.range p ≃ₗ[ℚ] coefficientField b,
        (∀ x, e ⟨p x, x, rfl⟩ = coefficientEvaluation b x) ∧
        Module.finrank ℚ (LinearMap.range p) = Module.finrank ℚ (coefficientField b) ∧
        0 < Module.finrank ℚ (LinearMap.range p) ∧
        Module.finrank ℚ (LinearMap.range p) ≤ Nat.card G := by
  let q := coefficientEvaluation b
  have hc := cocycle_of_splitting b c hb
  obtain ⟨j,hj,_,hp,hg⟩ := Prym.split_projective_quotient
    (fieldAction b) (twistedLeftShiftEquiv c) (fun g h => c (g,h))
    (fieldAction_mul b c hb) (twistedLeftShift_mul c hc)
    q (coefficientEvaluation_surjective b c hb)
    (coefficientEvaluation_twistedLeftShift b c hb)
  let p := j.comp q
  let e : coefficientField b ≃ₗ[ℚ] LinearMap.range p :=
    { toFun := fun z => ⟨j z, j z, congrArg j (hj z)⟩
      invFun := fun x => q x.1
      left_inv := hj
      right_inv := fun x => by
        apply Subtype.ext
        obtain ⟨y,hy⟩ := x.2
        change j (q x.1) = x.1
        rw [← hy]
        exact congrArg j (hj (q y))
      map_add' := fun x y => Subtype.ext (j.map_add x y)
      map_smul' := fun a x => Subtype.ext (j.map_smul a x) }
  refine ⟨p, hp, hg, e.symm, (fun x => hj (q x)), e.finrank_eq.symm, ?_⟩
  rw [← e.finrank_eq]
  obtain ⟨hfinite,hdegree⟩ := coefficientField_degree_le b c hb
  let := hfinite
  exact ⟨Module.finrank_pos, hdegree⟩

section Quotient

variable {H Γ : Type} [Group H] [Group Γ] (π : H →* Γ)
  (b : H → Qbarˣ) (c : Γ × Γ → ℚˣ)
  (hnormal : ∀ g, c (g, 1) = 1)
  (htwo : ∀ n : H, π n = 1 → n*n = 1)
  (hb : ∀ g h, rationalUnit (c (π g,π h)) = b g * b h / b (g*h))

include hnormal htwo hb

/-- On a kernel of exponent two a splitting cochain for a normalized
inflated cocycle takes the two rational signs as its only values. -/
theorem kernel_value_sign {n : H} (hn : π n = 1) :
    (b n : Qbar) = 1 ∨ (b n : Qbar) = -1 := by
  have h1 : b 1 = 1 := by simpa [hnormal] using (hb 1 1).symm
  have hnn : b n * b n = 1 := by
    simpa only [hn, hnormal, map_one, htwo n hn, h1, div_one] using (hb n n).symm
  apply sq_eq_one_iff.mp
  simpa only [pow_two, Units.val_one, Units.val_mul] using congrArg Units.val hnn

/-- One lift per element of the quotient spans the coefficient field. -/
theorem coefficientField_eq_span_lifts (lift : Γ → H) (hlift : Function.RightInverse lift π) :
    (coefficientField b).toSubalgebra.toSubmodule =
      Submodule.span ℚ (Set.range fun g => (b (lift g) : Qbar)) := by
  rw [coefficientField_eq_span b (fun z => c (π z.1,π z.2)) hb]
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨h,rfl⟩
    let a := lift (π h)
    let n := a⁻¹*h
    have hn : π n = 1 := by simp [n, a, hlift (π h)]
    have han : a*n = h := by simp [n]
    have eq : b h = b a * b n := by
      have fact := hb a n
      rw [hn,hnormal,map_one,han] at fact
      exact (div_eq_one.mp fact.symm).symm
    let S := Submodule.span ℚ (Set.range fun g => (b (lift g) : Qbar))
    have ha : (b a : Qbar) ∈ S := Submodule.subset_span ⟨π h,rfl⟩
    change (b h : Qbar) ∈ S
    rw [eq, Units.val_mul]
    rcases kernel_value_sign π b c hnormal htwo hb hn with hpos | hneg
    · rwa [hpos, mul_one]
    · rw [hneg, mul_neg_one]
      exact S.neg_mem ha
  · exact Submodule.span_mono (by rintro _ ⟨g,rfl⟩; exact ⟨lift g,rfl⟩)

/-- The degree bound uses the order of the quotient, even when the cochain
splits only after inflation to the larger group. -/
theorem coefficient_degree_le_quotient [Fintype Γ] (surj : Function.Surjective π) :
    Module.finrank ℚ (coefficientField b) ≤ Nat.card Γ := by
  classical
  choose lift hlift using surj
  change Module.finrank ℚ (coefficientField b).toSubalgebra.toSubmodule ≤ _
  rw [coefficientField_eq_span_lifts π b c hnormal htwo hb lift hlift]
  exact (finrank_span_le_card _).trans (by
    rw [Set.toFinset_card, ← Fintype.card_eq_nat_card]
    exact Fintype.card_range_le _)

/-- The equivariant projector after inflation has positive rational rank at
most the order of the original finite quotient. -/
theorem exists_projector_of_quotient [Fintype H] [Fintype Γ] (surj : Function.Surjective π) :
    ∃ p : Module.End ℚ (H → ℚ), p.comp p = p ∧
      (∀ g x, twistedLeftShift (fun z => c (π z.1,π z.2)) g (p x) =
        p (twistedLeftShift (fun z => c (π z.1,π z.2)) g x)) ∧
      ∃ e : LinearMap.range p ≃ₗ[ℚ] coefficientField b,
        (∀ x, e ⟨p x, x, rfl⟩ = coefficientEvaluation b x) ∧
        0 < Module.finrank ℚ (LinearMap.range p) ∧
        Module.finrank ℚ (LinearMap.range p) ≤ Nat.card Γ := by
  obtain ⟨p,hp,hg,e,he,hr,hpos,_⟩ :=
    exists_projector b (fun z => c (π z.1,π z.2)) hb
  exact ⟨p,hp,hg,e,he,hpos, hr.trans_le (coefficient_degree_le_quotient π b c hnormal htwo hb surj)⟩

end Quotient

end

end ZOverQ.Qualitative.FibrewiseProjector

