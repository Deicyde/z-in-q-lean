import PrimeTrace
import Mathlib.RingTheory.DedekindDomain.Different
import Mathlib.FieldTheory.KummerPolynomial

/-! The number field generated by a square root of two is unramified away from two.
The primitive element's derivative gives a multiple of the different, avoiding an integral basis. -/
namespace Sun28.Scalar
open Sun28.ScalarTrace IsDedekindDomain NumberField Polynomial
open scoped NumberField Polynomial

private theorem rat_sq_ne_two (q : ℚ) : q^2 ≠ 2 := by
  intro eq
  have hs : IsSquare (2:ℚ) := ⟨q,by simpa [pow_two] using eq.symm⟩
  have hh : ¬IsSquare (2:ℕ) := (Nat.prime_iff.mp Nat.prime_two).not_isSquare
  exact hh (Rat.isSquare_natCast_iff.mp hs)

/-- The different of the quadratic number field containing sqrt(2) contains 8. -/
theorem eight_mem_different {K : Type*} [Field K] [NumberField K] [Algebra.IsQuadraticExtension ℚ K]
    {ρ : K} (root : ρ^2=2) : (8:𝓞 K) ∈ differentIdeal ℤ (𝓞 K) := by
  let zz : ℤ[X] := X^2-C 2
  let qq : ℚ[X] := X^2-C 2
  have mz : zz.Monic := monic_X_pow_sub_C _ (by decide)
  have mq : qq.Monic := monic_X_pow_sub_C _ (by decide)
  have integral : IsIntegral ℤ ρ := ⟨zz,mz,by simp [zz,root]⟩
  let t : 𝓞 K := ⟨ρ,integral⟩
  have rt : t^2=2 := by
    apply Subtype.ext
    change ρ^2=2
    exact root
  have minq : qq = minpoly ℚ ρ := minpoly.eq_of_irreducible_of_monic
    (X_pow_sub_C_irreducible_of_prime Nat.prime_two rat_sq_ne_two) (by simp [qq,root]) mq
  have minz : minpoly ℤ t=zz := by
    apply Polynomial.map_injective (algebraMap ℤ ℚ) (Int.cast_injective (α:=ℚ))
    rw [←minpoly.isIntegrallyClosed_eq_field_fractions ℚ K (IsIntegralClosure.isIntegral ℤ K t)]
    change minpoly ℚ ρ=_
    rw [←minq]
    simp [qq,zz]
    exact map_ofNat Polynomial.C 2
  have simple : IsSimpleOrder (Subalgebra ℚ K) := Subalgebra.isSimpleOrder_of_finrank_prime ℚ K
    (by rw [Algebra.IsQuadraticExtension.finrank_eq_two ℚ K]; decide)
  have prim : Algebra.adjoin ℚ {algebraMap (𝓞 K) K t}=⊤ := by
    rcases simple.eq_bot_or_eq_top (Algebra.adjoin ℚ {algebraMap (𝓞 K) K t}) with he|he
    · have mem := Algebra.subset_adjoin (R:=ℚ) (Set.mem_singleton (algebraMap (𝓞 K) K t))
      rw [he] at mem
      obtain ⟨q,hq⟩ := mem
      change algebraMap ℚ K q=ρ at hq
      have hq2 : algebraMap ℚ K (q^2) = algebraMap ℚ K 2 := by rw [map_pow,hq,root,map_ofNat]
      exact False.elim (rat_sq_ne_two q ((algebraMap ℚ K).injective hq2))
    · exact he
  have deriv := aeval_derivative_mem_differentIdeal ℤ ℚ K t prim
  rw [minz] at deriv
  have small : 2*t ∈ differentIdeal ℤ (𝓞 K) := by
    rw [show derivative zz=C (2:ℤ)*X by simp [zz,derivative_pow]] at deriv
    simpa only [map_mul,aeval_C,aeval_X,map_ofNat] using deriv
  have sq : (2*t)^2 ∈ differentIdeal ℤ (𝓞 K) := Ideal.pow_mem_of_mem _ small _ (by decide)
  rw [mul_pow,rt] at sq
  norm_num at sq ⊢
  exact sq

/-- Every prime above an odd rational prime is unramified for this quadratic field. -/
theorem sqrtTwo_unramified {K : Type*} [Field K] [NumberField K] [Algebra.IsQuadraticExtension ℚ K]
    {ρ : K} (root : ρ^2=2) (v : HeightOneSpectrum (𝓞 ℚ))
    (w : HeightOneSpectrum (𝓞 K)) [w.asIdeal.LiesOver v.asIdeal] {p : ℕ}
    (name : (Rat.HeightOneSpectrum.primesEquiv v).1=p) (hp : 2<p) :
    w.asIdeal.ramificationIdx (𝓞 ℚ)=1 := by
  have nd : ¬p ∣ 2 := fun h => (Nat.not_lt_of_ge (Nat.le_of_dvd (by decide) h)) hp
  have ht : padicValRat p (2:ℚ)=0 := by
    simpa [padicValRat.of_nat,padicValNat.eq_zero_of_not_dvd nd] using (padicValRat.of_nat (p:=p) (n:=2))
  have hv : v.valuation ℚ (2:ℚ)=1 := by simpa [name,ht] using (rationalPrime_value v (q:=2) (by norm_num))
  have hw : w.valuation K (2:K)=1 := by
    simpa [hv] using (HeightOneSpectrum.valuation_liesOver K v w (2:ℚ)).symm
  have two_mem : (2:𝓞 K) ∉ w.asIdeal :=
    (w.valuation_eq_one_iff_notMem (K:=K) (r:=(2:𝓞 K))).mp (by rw [map_ofNat]; exact hw)
  have eight_ne : (8:𝓞 K) ∉ w.asIdeal := by
    rw [show (8:𝓞 K) = 2^3 by norm_num]
    exact fun h => two_mem (w.isPrime.mem_of_pow_mem 3 h)
  have notdvd : ¬w.asIdeal ∣ differentIdeal ℤ (𝓞 K) :=
    fun h => eight_ne ((Ideal.dvd_iff_le.mp h) (eight_mem_different root))
  let _ : Algebra.IsUnramifiedAt ℤ w.asIdeal := not_dvd_differentIdeal_iff.mp notdvd
  have total : w.asIdeal.ramificationIdx ℤ=1 := Ideal.ramificationIdx_eq_one_of_isUnramifiedAt
  have dvd : w.asIdeal.ramificationIdx (𝓞 ℚ) ∣ w.asIdeal.ramificationIdx ℤ :=
    Ideal.ramificationIdx_above_dvd (R:=ℤ) v.asIdeal w.asIdeal
  exact Nat.eq_one_of_dvd_one (total ▸ dvd)

end Sun28.Scalar
#print axioms Sun28.Scalar.eight_mem_different
#print axioms Sun28.Scalar.sqrtTwo_unramified
