import RealFactors
import ZInQKernel.Multiplication.Local.FormalGroup

namespace Sun28.Ordinary
open ZInQ ZInQ.Mult WeierstrassCurve.Affine

private theorem odd_torsion (n : ℤ) (odd : Odd n) : n • cT0 = cT0 := by
  obtain ⟨k,rfl⟩ := odd
  have t : (2:ℤ) • cT0 = 0 := by
    exact_mod_cast (curveC_two_torsion cT0).2 (Or.inr (Or.inl rfl))
  rw [show 2*k+1=k*2+1 by ring,add_zsmul,mul_zsmul,t,zsmul_zero,one_zsmul,zero_add]

/-- In any subgroup quotient, an odd annihilator of P excludes the class of
a nonzero point of order two from the cyclic subgroup generated by P. -/
private theorem distinct_cosets (G : AddSubgroup curveC.toAffine.Point) (outside : cT0 ∉ G)
    (P : curveC.toAffine.Point) (i j : ℤ) (odd : Odd i) (pole : i • P ∈ G)
    (zero : j • P + cT0 ∈ G) : False := by
  have a := G.zsmul_mem zero i
  have b := G.zsmul_mem pole j
  rw [zsmul_add,odd_torsion i odd,smul_comm i j] at a
  exact outside (by simpa using G.sub_mem a b)

/-- Translation by the distinguished two-torsion point sends x to −δ²/x. -/
theorem abscissa_translate (m : ℤ) (nz : m≠0) :
    ∃ y h, m • curveGenerator+cT0 = .some (-delta^2 / indexX m) y h := by
  obtain ⟨y,h,p⟩ := index_affine nz
  have live := indexX_nonzero nz
  rw [p]
  refine curveC_add_of_X_ne h _ live ?_
  have curve := (curveC_equation_iff _ _).mp h.1
  simp only [sub_zero]
  field_simp [live]
  linear_combination curve

/-- An odd multiple with a pole excludes zeros deeper than twice the order of δ
among all its companion multiples. This also holds at bad finite places. -/
theorem local_order_separation (v : AddValuation K0 (WithTop ℤ))
    (int : 0 ≤ v (-delta^2)) (i j : ℤ) (odd : Odd i) (nj : j≠0)
    (pole : v (indexX i) < 0) : v (indexX j) ≤ v (-delta^2) := by
  classical
  have ni : i≠0 := by obtain ⟨k,hk⟩ := odd; omega
  let G := formalNbhd (v:=v) (-delta^2) int
  have no : cT0 ∉ G := by
    intro belong
    have z := (mem_formalNbhd_iff int cT0).mp belong
    change v 0 < 0 at z
    simp at z
  obtain ⟨y,h,hi⟩ := index_affine ni
  have gi : i • curveGenerator ∈ G := by
    apply (mem_formalNbhd_iff int _).mpr
    rw [hi]
    exact pole
  by_contra! bad
  obtain ⟨t,on,trans⟩ := abscissa_translate j nj
  have gj : j • curveGenerator+cT0 ∈ G := by
    apply (mem_formalNbhd_iff int _).mpr
    rw [trans]
    change v (-delta^2/indexX j)<0
    obtain ⟨a,ha⟩ := Scalar.finite_order v (neg_ne_zero.mpr (pow_ne_zero 2 delta_ne_zero))
    obtain ⟨b,hb⟩ := Scalar.finite_order v (indexX_nonzero nj)
    rw [ha,hb] at bad
    rw [div_eq_mul_inv,v.map_mul,v.map_inv,ha,hb]
    exact_mod_cast (show a + -b < 0 by exact sub_neg.mpr (WithTop.coe_lt_coe.mp bad))
  exact distinct_cosets G no curveGenerator i j odd gi gj

end Sun28.Ordinary
#print axioms Sun28.Ordinary.abscissa_translate
#print axioms Sun28.Ordinary.local_order_separation
