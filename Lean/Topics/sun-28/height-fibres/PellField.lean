import PellRows
import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.NumberTheory.NumberField.Discriminant.Defs
import Mathlib.NumberTheory.NumberField.Units.Regulator

/-! The actual splitting field of the simultaneous Pell system. -/
namespace Sun28.HeightFibres
open Polynomial
noncomputable section
abbrev Omega := AlgebraicClosure ℚ

private theorem root_degree (a : ℤ) {r : Omega} (hr : r^2=(a:Omega)) :
    Module.finrank ℚ (IntermediateField.adjoin ℚ ({r} : Set Omega)) ≤ 2 := by
  let P : ℚ[X] := X^2-C (a:ℚ)
  have m : P.Monic := monic_X_pow_sub_C _ (by decide)
  have z : aeval r P=0 := by simp [P,hr]
  rw [IntermediateField.adjoin.finrank (show IsIntegral ℚ r from ⟨P,m,z⟩)]
  exact (natDegree_le_natDegree (minpoly.min ℚ r m z)).trans_eq natDegree_X_pow_sub_C

instance finitePair (r w : Omega) : FiniteDimensional ℚ (IntermediateField.adjoin ℚ ({r,w} : Set Omega)) :=
  IntermediateField.finiteDimensional_adjoin_pair (Algebra.IsIntegral.isIntegral r) (Algebra.IsIntegral.isIntegral w)

instance finiteNumberField (L : IntermediateField ℚ Omega) [FiniteDimensional ℚ L] : NumberField L :=
  NumberField.of_module_finite ℚ L

def numberLog (z : ℤ) : ℝ := Real.log (z.natAbs:ℝ)
def logStar (u : ℝ) : ℝ := max 1 (Real.log u)

/-- Classical discriminant identity for the field generated by the square roots
of gh and gk. The three quadratic characters have radicands gh, gk and hk.
Each associated quadratic discriminant has size at most four times the radicand. -/
def BiquadraticDiscriminants : Prop :=
  ∀ (g h k : ℤ) (r w : Omega), g≠0 → h≠0 → k≠0 → r^2=(g:Omega)*h → w^2=(g:Omega)*k →
    let L:=IntermediateField.adjoin ℚ ({r,w} : Set Omega)
    (NumberField.discr L).natAbs ≤ 64*(g.natAbs*h.natAbs*k.natAbs)^2

/-- Bérczes, Evertse and Győry, Lemma 3.5 and equation (4.17), at degree
at most four. The integer class number is at least one. -/
def RegulatorBound : Prop :=
  ∀ (L : IntermediateField ℚ Omega) [FiniteDimensional ℚ L], Module.finrank ℚ L≤4 →
    let D:ℝ:=(NumberField.discr L).natAbs
    NumberField.Units.regulator L≤D*(logStar D)^3

/-- Proposition 3.12 of the same paper for integer points and archimedean S,
whose cardinality and field degree are at most four. -/
def PublishedPell312 : Prop :=
  ∀ (L : IntermediateField ℚ Omega) [FiniteDimensional ℚ L], Module.finrank ℚ L≤4 →
    ∀ (g h k a b c D₁ D₂ : ℤ), g≠0 → h≠0 → k≠0 → D₁≠0 → D₂≠0 → D₁≠D₂ →
    (∃ r : L, r^2=(g:L)/(h:L)) → (∃ w : L,w^2=(g:L)/(k:L)) →
    g*a^2-h*b^2=D₁ → g*a^2-k*c^2=D₂ →
    ∀ H J : ℝ, numberLog g≤H → numberLog h≤H → numberLog k≤H →
    numberLog D₁≤J → numberLog D₂≤J →
    let reg:=NumberField.Units.regulator L
    numberLog a≤(2:ℝ)^140*reg*(1+logStar reg)*(reg+4*H+J)

/-- Only two square roots are needed over the rationals, including dependent
and negative squareclasses. The regulator and discriminant are attached to
the very field in which the two coefficient ratios become squares. -/
theorem pell_field {g h k : ℤ} (ng : g≠0) (nh : h≠0) (nk : k≠0)
    (disc : BiquadraticDiscriminants) :
    ∃ L : IntermediateField ℚ Omega, ∃ _ : FiniteDimensional ℚ L, Module.finrank ℚ L≤4 ∧
      (∃ r : L,r^2=(g:L)/(h:L)) ∧ (∃ w : L,w^2=(g:L)/(k:L)) ∧
      (NumberField.discr L).natAbs≤64*(g.natAbs*h.natAbs*k.natAbs)^2 := by
  obtain ⟨r,hr⟩:=IsAlgClosed.exists_pow_nat_eq ((g*h:ℤ):Omega) (by decide : 0<2)
  obtain ⟨w,hw⟩:=IsAlgClosed.exists_pow_nat_eq ((g*k:ℤ):Omega) (by decide : 0<2)
  let L:=IntermediateField.adjoin ℚ ({r,w} : Set Omega)
  let R:=IntermediateField.adjoin ℚ ({r}:Set Omega)
  let W:=IntermediateField.adjoin ℚ ({w}:Set Omega)
  have eq : R ⊔ W=L := by dsimp [L,R,W];rw [←IntermediateField.adjoin_union,Set.singleton_union]
  have dim : Module.finrank ℚ L≤4 := by
    rw [←eq]
    exact (IntermediateField.finrank_sup_le R W).trans (Nat.mul_le_mul (root_degree _ hr) (root_degree _ hw))
  let rL : L:=⟨r,IntermediateField.mem_adjoin_pair_left ℚ r w⟩
  let wL : L:=⟨w,IntermediateField.mem_adjoin_pair_right ℚ r w⟩
  have sr : rL^2=(g:L)*h := Subtype.ext (by simpa using hr)
  have sw : wL^2=(g:L)*k := Subtype.ext (by simpa using hw)
  refine ⟨L,finitePair r w,dim,⟨rL/(h:L),?_⟩,⟨wL/(k:L),?_⟩,?_⟩
  · rw [div_pow,sr]
    field_simp [show (h:L)≠0 by exact_mod_cast nh]
  · rw [div_pow,sw]
    field_simp [show (k:L)≠0 by exact_mod_cast nk]
  · exact disc g h k r w ng nh nk (by simpa using hr) (by simpa using hw)

end
end Sun28.HeightFibres
#print axioms Sun28.HeightFibres.pell_field
