import FixedCurve
import Mathlib.FieldTheory.Normal.Closure
import Mathlib.NumberTheory.NumberField.Discriminant.Different
import Mathlib.NumberTheory.RamificationInertia.Galois
import Mathlib.NumberTheory.RamificationInertia.Valuation

/-! The field generated by both nonzero coordinates of the fixed six-branch curve. -/
namespace Sun28.FiveDescent.ResidueField
open IntermediateField NumberField
noncomputable section
abbrev Omega := AlgebraicClosure ℚ
abbrev coords (r w : Omega) := IntermediateField.adjoin ℚ ({r,w} : Set Omega)

instance numberField (r w : Omega) : NumberField (coords r w) where
  to_charZero := inferInstance
  to_finiteDimensional := IntermediateField.finiteDimensional_adjoin_pair (Algebra.IsIntegral.isIntegral r)
    (Algebra.IsIntegral.isIntegral w)

theorem generated_coordinates (r w : Omega) {x y : ℚ} (nx : x≠0) (ny : y≠0) :
    coords (r*algebraMap ℚ Omega x) (w*algebraMap ℚ Omega y)=coords r w := by
  have inc (r w : Omega) (x y : ℚ) :
      coords (r*algebraMap ℚ Omega x) (w*algebraMap ℚ Omega y)≤coords r w := by
    refine adjoin_le_iff.mpr ?_
    intro z hz
    rcases Set.mem_insert_iff.mp hz with e|e
    · exact e ▸ mul_mem (mem_adjoin_pair_left _ _ _) ((coords r w).algebraMap_mem x)
    · rw [Set.mem_singleton_iff.mp e]
      exact mul_mem (mem_adjoin_pair_right _ _ _) ((coords r w).algebraMap_mem y)
  apply le_antisymm (inc r w x y)
  simpa only [mul_assoc,←map_mul,mul_inv_cancel₀ nx,mul_inv_cancel₀ ny,map_one,mul_one] using
    inc (r*algebraMap ℚ Omega x) (w*algebraMap ℚ Omega y) x⁻¹ y⁻¹

theorem roots_galois {d e : ℤ} {r w : Omega} (hr:r^2=(d:Omega)) (hw:w^2=(e:Omega)) :
    IsGalois ℚ (coords r w) := by
  have normal : Normal ℚ (coords r w) := by
    apply IntermediateField.normal_iff_forall_map_le.mpr
    intro σ
    rw [show coords r w=adjoin ℚ {r,w} from rfl,adjoin_map]
    apply adjoin_le_iff.mpr
    rintro z ⟨z,h,rfl⟩
    have root {u : Omega} {a : ℤ} (h : u^2=(a:Omega)) (mem : u ∈ coords r w) :
        σ u ∈ coords r w := by
      have eq : (σ u)^2=u^2 := by rw [←map_pow,h,map_intCast]
      rcases sq_eq_sq_iff_eq_or_eq_neg.mp eq with v|v
      · simpa only [v] using mem
      · rw [v]; exact neg_mem mem
    rcases Set.mem_insert_iff.mp h with v|v
    · rw [v]; exact root hr (mem_adjoin_pair_left _ _ _)
    · rw [Set.mem_singleton_iff.mp v]; exact root hw (mem_adjoin_pair_right _ _ _)
  exact { to_normal := normal }

theorem integral_root {L : Type*} [Field L] [CharZero L] {u : L} {a : ℤ}
    (h : u^2=(a:L)) : IsIntegral ℤ u := by
  apply IsIntegral.of_pow (n:=2) (by decide)
  rw [h]
  exact isIntegral_algebraMap

end
end Sun28.FiveDescent.ResidueField
#print axioms Sun28.FiveDescent.ResidueField.generated_coordinates
#print axioms Sun28.FiveDescent.ResidueField.roots_galois
#print axioms Sun28.FiveDescent.ResidueField.integral_root
