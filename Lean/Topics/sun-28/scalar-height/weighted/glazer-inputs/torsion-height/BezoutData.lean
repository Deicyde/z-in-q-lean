import MarkedTorsion

namespace ZInQBlueprint.MarkedTorsion
open scoped BigOperators
set_option maxRecDepth 12000
set_option exponentiation.threshold 1024

/-- Coefficients in ascending powers of the first homogeneous variable. -/
def poly3 (co:Fin 4→ℤ) (u v:ℤ) := co 0*v^3+co 1*u*v^2+co 2*u^2*v+co 3*u^3
def polyNorm (co:Fin 4→ℤ) := |co 0|+|co 1|+|co 2|+|co 3|
