import IntegralSections
import Mathlib.LinearAlgebra.TensorProduct.Basic

/-! Literal bicanonical tensors in the lattice generated by pairs of integral differentials. -/
namespace ZInQBlueprint.IntegralSections
open scoped TensorProduct
noncomputable section

variable (V K : Type*) [CommRing V] [IsDomain V] [Field K] [Algebra V K]

/-- The image lattice of the tensor square of integral relative differentials,
written as the integral span of pure tensors in the generic fibre. -/
def quadraticLattice :
    Submodule V (KaehlerDifferential ℤ K ⊗[K] KaehlerDifferential ℤ K) :=
  Submodule.span V {w | ∃ a b : KaehlerDifferential ℤ V,
    w = (KaehlerDifferential.map ℤ ℤ V K a) ⊗ₜ[K] (KaehlerDifferential.map ℤ ℤ V K b)}

set_option maxHeartbeats 2000000
variable {V K} [IsFractionRing V K] [IsDiscreteValuationRing V]

/-- The actual marked quadratic differentials, without a chosen basis or tangent operator. -/
theorem bicanonical_sections (p : ℕ) (hp : Irreducible (p : V)) (t : K)
    (off : branchProduct t ≠ 0) :
    let dt := KaehlerDifferential.D ℤ K t
    let q := (branchProduct t)⁻¹ • (dt ⊗ₜ[K] dt)
    (823200 : K) • q ∈ quadraticLattice V K ∧
    (75*t) • q ∈ quadraticLattice V K ∧
    (32*(t+343)) • q ∈ quadraticLattice V K := by
  let d := KaehlerDifferential.D ℤ K
  let dt := d t
  let T := dt ⊗ₜ[K] dt
  let S := quadraticLattice V K
  let M := KaehlerDifferential.map ℤ ℤ V K
  have diff (a : ℤ) (h : t-(a:K) ≠ 0) :
      ∃ w : KaehlerDifferential ℤ V, M w = (t-(a:K))⁻¹ • dt := by
    obtain ⟨w, hw⟩ := log_kaehler_integral p hp (t-(a:K)) h
    use w
    simpa only [Derivation.map_sub, Derivation.map_intCast, sub_zero, dt, d, M] using hw
  have off' : t≠0 ∧ t-32≠0 ∧ t-76832≠0 ∧ t+343≠0 := by
    simpa only [branchProduct, mul_ne_zero_iff, and_assoc] using off
  obtain ⟨h0,h1,h2,h3⟩ := off'
  obtain ⟨a,ha⟩ : ∃ w, M w = t⁻¹ • dt := by
    simpa using diff 0 (by simpa using h0)
  obtain ⟨b,hb⟩ : ∃ w, M w = (t-32)⁻¹ • dt := by
    simpa using diff 32 (by simpa using h1)
  obtain ⟨c,hc⟩ : ∃ w, M w = (t-76832)⁻¹ • dt := by
    simpa using diff 76832 (by simpa using h2)
  obtain ⟨e,he⟩ : ∃ w, M w = (t+343)⁻¹ • dt := by
    simpa using diff (-343) (by simpa using h3)
  have product {u v : K} {w z : KaehlerDifferential ℤ V}
      (hw : M w = u • dt) (hz : M z = v • dt) : (u*v) • T ∈ S := by
    have mem : M w ⊗ₜ[K] M z ∈ S := Submodule.subset_span ⟨w,z,rfl⟩
    simpa only [hw,hz,TensorProduct.smul_tmul',TensorProduct.tmul_smul,smul_smul,T,mul_comm v u] using mem
  have Z (c : ℤ) {v : K} (h : v • T ∈ S) : ((c : K)*v) • T ∈ S := by
    have z : c • (v • T) ∈ S := S.toAddSubgroup.zsmul_mem h c
    simpa only [← Int.cast_smul_eq_zsmul K,smul_smul] using z
  have H {u v : K} (hu : u • T ∈ S) (hv : v • T ∈ S) : (u-v) • T ∈ S := by
    simpa only [sub_smul] using S.sub_mem hu hv
  have ids := section_identities t (1:K) off
  dsimp only at ids
  simp only [one_div,one_pow] at ids
  have z205 : ((205:ℤ):K)=205 := by norm_num
  have zn75 : ((-75:ℤ):K)= -75 := by norm_num
  have z32 : ((32:ℤ):K)=32 := by norm_num
  have tmp := Z 205 (H (product hb hc) (product hc he))
  rw [z205] at tmp
  have qt : (75*t*(branchProduct t)⁻¹) • T ∈ S := by
    rw [ids.1,add_smul]
    exact S.add_mem (H (product hb he) (product hc he))
      tmp
  have second : 32*(t+343)*(branchProduct t)⁻¹ = (t-32)⁻¹*(t-76832)⁻¹ - t⁻¹*(t-76832)⁻¹ := by
    unfold branchProduct
    field_simp [h0,h1,h2,h3]
    ring
  change (823200 : K) • (branchProduct t)⁻¹ • T ∈ S ∧ (75*t) • (branchProduct t)⁻¹ • T ∈ S ∧
    (32*(t+343)) • (branchProduct t)⁻¹ • T ∈ S
  rw [smul_smul,smul_smul,smul_smul,second]
  refine ⟨?_,qt,?_⟩
  swap
  · exact H (product hb hc) (product ha hc)
  rw [ids.2, ← ids.1]
  have c0 := Z (-75) (H (product ha hc) (product hb hc))
  have c1 := Z 32 qt
  rw [zn75] at c0
  rw [z32] at c1
  exact H c0 c1

end
end ZInQBlueprint.IntegralSections
#print axioms ZInQBlueprint.IntegralSections.bicanonical_sections
