import ScalarField
import Mathlib.NumberTheory.ModularForms.CongruenceSubgroups
import Mathlib.NumberTheory.Cyclotomic.Gal
import Mathlib.RingTheory.RootsOfUnity.AlgebraicallyClosed

namespace ZInQBlueprint.DiamondHeight
open CongruenceSubgroup
open scoped MatrixGroups
noncomputable section

/-- Restrict absolute automorphisms to the subfield generated by a primitive
root of unity, then read the exponent of the root. -/
def cyclotomicQuotient {N:ℕ} [NeZero N] {ζ : AlgebraicClosure ℚ} (hz : IsPrimitiveRoot ζ N) :
    Field.absoluteGaloisGroup ℚ →* (ZMod N)ˣ := by
  let L := IntermediateField.adjoin ℚ ({ζ}:Set (AlgebraicClosure ℚ))
  let : IsCyclotomicExtension {N} ℚ L :=
    (IntermediateField.isCyclotomicExtension_singleton_iff_eq_adjoin N ℚ (AlgebraicClosure ℚ) L hz).mpr rfl
  let : IsGalois ℚ L := IsCyclotomicExtension.isGalois {N} ℚ L
  exact (IsCyclotomicExtension.autEquivPow L (Polynomial.cyclotomic.irreducible_rat (NeZero.pos N))).toMonoidHom.comp
    (AlgEquiv.restrictNormalHom L)

theorem cyclotomic_onto {N:ℕ} [NeZero N] {ζ : AlgebraicClosure ℚ} (hz : IsPrimitiveRoot ζ N) :
    Function.Surjective (cyclotomicQuotient hz) := by
  let L := IntermediateField.adjoin ℚ ({ζ}:Set (AlgebraicClosure ℚ))
  let : IsCyclotomicExtension {N} ℚ L :=
    (IntermediateField.isCyclotomicExtension_singleton_iff_eq_adjoin N ℚ (AlgebraicClosure ℚ) L hz).mpr rfl
  let : IsGalois ℚ L := IsCyclotomicExtension.isGalois {N} ℚ L
  exact (IsCyclotomicExtension.autEquivPow L (Polynomial.cyclotomic.irreducible_rat (NeZero.pos N))).surjective.comp
    (AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure ℚ) (F:=ℚ) (K₁:=L))

/-- The subgroup Γ_H of the integral modular group defined by the lower-right entry. -/
def gammaChar {N:ℕ} (ε : (ZMod N)ˣ →* ℂˣ) : Subgroup SL(2,ℤ) :=
  (ε.ker.comap (Gamma0Map N).toHomUnits).map (Gamma0 N).subtype

/-- Only an upper bound on the relative index is needed for the height.
The absolute cyclotomic map is surjective at every positive level. -/
theorem gamma_index {N : ℕ} [NeZero N] {ζ : AlgebraicClosure ℚ} (hz:IsPrimitiveRoot ζ N)
    (ε : (ZMod N)ˣ →* ℂˣ) :
    (gammaChar ε).index ≤ (ε.comp (cyclotomicQuotient hz)).ker.index * (Gamma0 N).index := by
  change _ ≤ (ε.ker.comap (cyclotomicQuotient hz)).index * _
  rw [Subgroup.index_comap_of_surjective ε.ker (cyclotomic_onto hz),gammaChar,Subgroup.index_map_subtype,Subgroup.index_comap]
  apply Nat.mul_le_mul_right
  exact Nat.le_of_dvd (Nat.pos_of_ne_zero Subgroup.FiniteIndex.index_ne_zero)
    (Subgroup.relIndex_dvd_index_of_normal ..)

end
end ZInQBlueprint.DiamondHeight
#print axioms ZInQBlueprint.DiamondHeight.cyclotomic_onto
#print axioms ZInQBlueprint.DiamondHeight.gamma_index
