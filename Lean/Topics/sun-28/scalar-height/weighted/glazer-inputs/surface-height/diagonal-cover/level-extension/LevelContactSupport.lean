import EtaleEvaluation
import LevelDiscriminant
import Mathlib.RingTheory.Coprime.Lemmas

namespace ZInQBlueprint.LevelExtension
open NumberField Sun28.Ordinary Diagonal210
open scoped NumberField
noncomputable section

private theorem prime_avoids_210 {L : Type*} [Field L] [NumberField L]
    (P : Ideal (𝓞 L)) [hP : P.IsPrime] {p : ℕ} [hp : Fact p.Prime]
    (large : 7<p) (inside : (p:𝓞 L)∈P) : (210:𝓞 L)∉P := by
  have cp : Nat.Coprime p 210 := by
    apply hp.out.coprime_iff_not_dvd.mpr
    have miss (a : ℕ) (small : a≤7) (pos : 0<a) : ¬ p∣a :=
      fun d => (not_le_of_gt large) ((Nat.le_of_dvd pos d).trans small)
    rw [show 210=2*3*5*7 by decide]
    simp only [hp.out.dvd_mul]
    rintro (((h|h)|h)|h) <;> first | exact miss 2 (by decide) (by decide) h | exact miss 3 (by decide) (by decide) h | exact miss 5 (by decide) (by decide) h | exact miss 7 (by decide) (by decide) h
  have bez : IsCoprime (p:𝓞 L) (210:𝓞 L) := by
    simpa only [map_natCast,map_ofNat,Nat.cast_ofNat] using cp.isCoprime.map (Int.castRingHom (𝓞 L))
  intro h
  obtain ⟨a,b,eq⟩:=bez
  exact hP.ne_top ((Ideal.eq_top_iff_one P).mpr (eq ▸ P.add_mem (P.mul_mem_left a inside) (P.mul_mem_left b h)))

/-- In a field generated by the generic evaluations of a finite étale level
fibre, the original five contacts give the exact large-prime discriminant support. -/
theorem contact_iff_level_discriminant {A B : ℤ} (cop : Int.gcd A B=1)
    (hn : ∀ i,oldForm i A B≠0) (y : Fibre ℂ coefficient ((A:ℚ)/B))
    (L : Type*) [Field L] [NumberField L] [Algebra (rootField y) L]
    [IsScalarTower ℚ (rootField y) L] [IsGalois (rootField y) L]
    {S : Type*} [CommRing S] [Algebra (away (rootField y)) S]
    [Module.Finite (away (rootField y)) S] [Algebra.Etale (away (rootField y)) S]
    {E : Set (S →ₐ[away (rootField y)] L)} (gen : Generates E)
    {p : ℕ} [Fact p.Prime] (large : 7<p) (cutoff : Finset ℕ) (out : p∉cutoff) :
    p∈oldContactPrimes cutoff A B ↔ (p:ℤ)∣NumberField.discr L := by
  constructor
  · intro contact
    exact dvd_trans ((discriminant_iff_contact large cop hn y cutoff out).mpr contact)
      (NumberField.discr_dvd_discr (rootField y) L)
  · apply level_discriminant_support cop hn y L large cutoff out
    intro P _ hpP
    exact relative_unramified gen P (prime_avoids_210 P large hpP)

end
end ZInQBlueprint.LevelExtension
#print axioms ZInQBlueprint.LevelExtension.contact_iff_level_discriminant
