import OrbitClasses

namespace Sun28.GlobalDescent
open Sun28.GlobalSections Sun28.PairedClasses Sun28.PreparedPoles Sun28.PrescribedPoints
  Sun28.TwistRank Sun28.TwistExtension Sun28.PointFibres Sun28.PointLifts
noncomputable section

/-- A rational point on one of the two explicit genus-one curves, in the physical interval. -/
def SectionHit (b θ:ℕ) : Prop := ∃s:ℚ, 0<s ∧ s^2<θ ∧
    (IsSquare ((b:ℚ)*(θ-s^2)*(3*s^2+θ)) ∨ IsSquare (3*(b:ℚ)*(θ-s^2)*(s^2+3*θ)))

private theorem admissible_nonsquare {b θ:ℕ} (a:AdmissiblePair b θ) : ¬IsSquare (b:ℚ) := by
  rintro sq
  obtain ⟨k,e⟩:=Rat.isSquare_natCast_iff.mp sq
  have mod3 : k*k%3=2:=by
    have h:=a.2.2.2.2.2.2.2.1
    rw [e] at h
    omega
  rw [Nat.mul_mod] at mod3
  have le:=Nat.mod_lt k (by decide : 0<3)
  interval_cases k%3 <;> norm_num at mod3

private theorem admissible_three {b θ:ℕ} (a:AdmissiblePair b θ) :
    padicValRat 3 (b:ℚ)=0 ∧ padicValRat 3 (θ:ℚ)=0 := by
  obtain ⟨_,_,_,_,_,_,_,bm,tm,_⟩:=a
  have b3 : (b:ZMod 3)=2:=(ZMod.natCast_eq_natCast_iff b 2 3).mpr
    (show b ≡ 17 [MOD 3] from (show b ≡ 17 [MOD 24] from bm).of_dvd (by decide))
  have t3 : (θ:ZMod 3)=1:=(ZMod.natCast_eq_natCast_iff θ 1 3).mpr
    ((show θ ≡ 1 [MOD 24] from tm).of_dvd (by decide : 3∣24))
  constructor
  · have v := order_zero_of_residue (p:=3) (residue_int (b:ℤ)) (by simpa [b3] using (show (b:ZMod 3)≠0 by rw [b3];decide))
    simpa using v
  · have v := order_zero_of_residue (p:=3) (residue_int (θ:ℤ)) (by simpa using (show (θ:ZMod 3)≠0 by rw [t3];decide))
    simpa using v

theorem hit_of_orbit {b θ:ℕ} (a:AdmissiblePair b θ) {s:ℚ} (pos:0<s) (short:s^2<θ)
    (unit:padicValRat 3 s=0) (hit:KnownOrbit (s^2/θ) (b*lead (s^2/θ))) : SectionHit b θ := by
  have tp : (0:ℚ)<θ:=by exact_mod_cast a.2.1
  have bp : (0:ℚ)<b:=by exact_mod_cast a.1
  obtain ⟨bv,tv⟩:=admissible_three a
  have rv:padicValRat 3 (s^2/θ)=0:=by
    rw [padicValRat.div (pow_ne_zero 2 pos.ne') tp.ne',padicValRat.pow,unit,tv];ring
  exact ⟨s,pos,short,(normalized_pair tp.ne').mp
    ((orbit_iff_two (div_pos (sq_pos_of_pos pos) tp) ((div_lt_one tp).mpr short) bp
      (admissible_nonsquare a) bv rv).mp hit)⟩

theorem ratio_of_section {b θ:ℕ} (a:AdmissiblePair b θ)
    (out:¬OneQuartic (b:ℚ) θ) (h:SectionHit b θ) :
    ∃ s:ℚ,0<s ∧ s^2<θ ∧ AllowedRatio b θ s ∧ padicValRat 3 s=0 ∧ represented b (s^2/θ) := by
  obtain ⟨s,pos,short,hit⟩:=h
  have tp : (0:ℚ)<θ:=by exact_mod_cast a.2.1
  have bp : (0:ℚ)<b:=by exact_mod_cast a.1
  have H:=represented_of_tests (div_pos (sq_pos_of_pos pos) tp) ((div_lt_one tp).mpr short) bp
    ((normalized_pair tp.ne').mpr hit)
  have F:=(single_iff_represented bp tp pos short (admissible_nonsquare a) out).mpr H
  exact ⟨s,pos,short,allowed_of_fibre a pos.ne' F,three_unit_of_fibre a pos.ne' F,H⟩

/-- The remaining point must be in a class outside the subgroup generated by the explicit section and torsion.
The two ordinary elliptic quartics are tested on the pair before any remaining ratio is chosen. -/
def DescentResidual : Prop := ∀ b θ:ℕ, AdmissiblePair b θ → InputClass b → FixedSquares θ →
  NormConic b θ → ¬FactorPair b θ → ¬OneQuartic (b:ℚ) θ →
  (∀ t:ℚ,t≠0 → ¬RatioCover (b:ℚ) θ t) → ¬CancelledFactors b θ → ¬SectionHit b θ →
  ∃ s:ℚ, 0<s ∧ s^2<θ ∧ AllowedRatio b θ s ∧ padicValRat 3 s=0 ∧
    ¬KnownOrbit (s^2/θ) (b*lead (s^2/θ)) ∧ represented b (s^2/θ)

theorem sections_iff_descent : SectionResidual ↔ DescentResidual := by
  constructor
  · intro H b θ a input fixed norm fac one pencil cancelled nosec
    obtain ⟨s,pos,short,rat,v,hit⟩:=H b θ a input fixed norm fac one pencil cancelled
    exact ⟨s,pos,short,rat,v,fun h=>nosec (hit_of_orbit a pos short v h),hit⟩
  · intro H b θ a input fixed norm fac one pencil cancelled
    by_cases hit:SectionHit b θ
    · exact ratio_of_section a one hit
    · obtain ⟨s,pos,short,rat,v,_,y⟩:=H b θ a input fixed norm fac one pencil cancelled hit
      exact ⟨s,pos,short,rat,v,y⟩

end
end Sun28.GlobalDescent
