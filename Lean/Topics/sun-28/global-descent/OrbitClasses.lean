import PhysicalSections

namespace Sun28.GlobalDescent
open Sun28.GlobalSections Sun28.PointLifts
noncomputable section

/-- The eight 2-isogeny characters generated by the known section and the four
rational 2-torsion points, before identifying proportional representatives. -/
def KnownOrbit (r d:ℚ) : Prop := ∃ t:ℚ, t≠0 ∧
    (d=t^2 ∨ d=(-rightRoot r)*t^2 ∨ d=(-leftRoot r)*t^2 ∨
      d=(rightRoot r*leftRoot r)*t^2 ∨ d=lead r*t^2 ∨
      d=(-rightRoot r*lead r)*t^2 ∨ d=(-leftRoot r*lead r)*t^2 ∨
      d=(rightRoot r*leftRoot r*lead r)*t^2)

private theorem both_roots {d r:ℚ} (lo:0<r) (hi:r<1) (dn:d≠0) (h:Mark r d) :
    Mark r (rightRoot r*leftRoot r*d) := by
  obtain ⟨bn,_,_⟩:=roots_regular lo hi
  have z:=orbit_left lo hi (mul_ne_zero (neg_ne_zero.mpr bn) dn) (orbit_right lo hi dn h)
  simpa only [neg_mul, mul_neg, neg_neg, mul_assoc, mul_left_comm, mul_comm] using z

theorem known_represented {r d:ℚ} (lo:0<r) (hi:r<1) (h:KnownOrbit r d) : Mark r d := by
  obtain ⟨t,tn,a|b|c|e|f|g|j|k⟩:=h
  · rw [a]
    simpa only [one_mul] using (rescale (r:=r) (d:=1) tn).mp (identity_class lo hi)
  · rw [b];apply (rescale tn).mp
    simpa using orbit_right lo hi one_ne_zero (identity_class lo hi)
  · rw [c];apply (rescale tn).mp
    simpa using orbit_left lo hi one_ne_zero (identity_class lo hi)
  · rw [e];apply (rescale tn).mp
    simpa using both_roots lo hi one_ne_zero (identity_class lo hi)
  · rw [f];exact (rescale tn).mp (moving_class lo hi)
  · rw [g];exact (rescale tn).mp (orbit_right lo hi (mul_ne_zero (sub_ne_zero.mpr hi.ne)
      (by linarith : r+3≠0)) (moving_class lo hi))
  · rw [j];exact (rescale tn).mp (orbit_left lo hi (mul_ne_zero (sub_ne_zero.mpr hi.ne)
      (by linarith : r+3≠0)) (moving_class lo hi))
  · rw [k];exact (rescale tn).mp (both_roots lo hi (mul_ne_zero (sub_ne_zero.mpr hi.ne)
      (by linarith : r+3≠0)) (moving_class lo hi))

private theorem parity_obstruction {b r:ℚ} (lo:0<r) (hi:r<1)
    (vb:padicValRat 3 b=0) (vr:padicValRat 3 r=0) :
    ¬∃t:ℚ,t≠0 ∧ b=rightRoot r*leftRoot r*t^2 := by
  obtain ⟨_,cn,_⟩:=roots_regular lo hi
  have B:0<rightRoot r:=by unfold rightRoot;positivity
  have three:padicValRat 3 (3:ℚ)=1:=padicValRat.self (by decide : 1<3)
  have first:padicValRat 3 (3*r+1)=0:=by
    rw [add_comm,padicValRat.add_eq_of_lt (by positivity) one_ne_zero (mul_ne_zero (by norm_num) lo.ne')]
    · simp
    · rw [padicValRat.mul (by norm_num) lo.ne',three];simp [vr]
  have second:padicValRat 3 (r+3)=0:=by
    rw [padicValRat.add_eq_of_lt (by positivity) lo.ne' (by norm_num)]
    · exact vr
    · omega
  have br:padicValRat 3 (rightRoot r)=0:=by
    rw [rightRoot,padicValRat.mul (by positivity) (by positivity),first,second,zero_add]
  rintro ⟨t,tn,eq⟩
  have v:=congrArg (padicValRat 3) eq
  rw [padicValRat.mul (mul_ne_zero B.ne' cn) (pow_ne_zero _ tn),padicValRat.mul B.ne' cn,
    br,leftRoot,padicValRat.mul (by norm_num) (pow_ne_zero _ (sub_ne_zero.mpr hi.ne)),
    padicValRat.pow,padicValRat.pow,three,vb] at v
  omega

theorem orbit_iff_two {b r:ℚ} (lo:0<r) (hi:r<1) (bp:0<b) (ns:¬IsSquare b)
    (vb:padicValRat 3 b=0) (vr:padicValRat 3 r=0) :
    KnownOrbit r (b*lead r) ↔ TwoSections b r := by
  have A:lead r<0:=mul_neg_of_neg_of_pos (sub_neg.mpr hi) (by linarith : 0<r+3)
  have B:0<rightRoot r:=by unfold rightRoot;positivity
  have C:0<leftRoot r:=by unfold leftRoot;positivity [sq_pos_of_ne_zero (sub_ne_zero.mpr hi.ne)]
  have neg:=mul_neg_of_pos_of_neg bp A
  constructor
  · rintro ⟨t,tn,one|two|three|four|five|six|seven|eight⟩
    · linarith [sq_nonneg t]
    · left
      refine ⟨(3*r+1)*t,?_⟩
      apply mul_left_cancel₀ (by linarith : r+3≠0)
      unfold firstValue lead rightRoot at *
      linear_combination -(3*r+1)*two
    · right
      refine ⟨3*(r-1)*t,?_⟩
      unfold secondValue lead leftRoot at *
      linear_combination -3*three
    · have own:=mul_pos (mul_pos B C) (sq_pos_of_ne_zero tn)
      linarith
    · apply (ns ⟨t,?_⟩).elim
      apply mul_left_cancel₀ A.ne
      linear_combination five
    · have positive:=mul_pos (mul_pos_of_neg_of_neg (neg_neg_of_pos B) A) (sq_pos_of_ne_zero tn)
      linarith
    · have positive:=mul_pos (mul_pos_of_neg_of_neg (neg_neg_of_pos C) A) (sq_pos_of_ne_zero tn)
      linarith
    · apply (parity_obstruction lo hi vb vr ⟨t,tn,?_⟩).elim
      apply mul_left_cancel₀ A.ne
      linear_combination eight
  · rintro (⟨k,h⟩|⟨k,h⟩)
    · have P:0<firstValue r:=by unfold firstValue;positivity [sub_pos.mpr hi]
      have kn:k≠0:=fun e=>(mul_pos bp P).ne' (by simpa [e] using h)
      have nz:3*r+1≠0:=by positivity
      refine ⟨k/(3*r+1),div_ne_zero kn nz,Or.inr (Or.inl ?_)⟩
      field_simp
      unfold lead firstValue rightRoot at *
      linear_combination -(r+3)*(3*r+1)*h
    · have P:0<secondValue r:=by unfold secondValue;positivity [sub_pos.mpr hi]
      have kn:k≠0:=fun e=>(mul_pos bp P).ne' (by simpa [e] using h)
      have nz:r-1≠0:=sub_ne_zero.mpr hi.ne
      refine ⟨k/(3*(r-1)),div_ne_zero kn (mul_ne_zero (by norm_num) nz),Or.inr (Or.inr (Or.inl ?_))⟩
      field_simp
      unfold lead secondValue leftRoot at *
      linear_combination -3*(r-1)^2*h

end
end Sun28.GlobalDescent
#print axioms Sun28.GlobalDescent.known_represented
