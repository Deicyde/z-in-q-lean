import ResidueExtension
import HenselTriples
import Mathlib.RingTheory.WittVector.Compare
import Mathlib.RingTheory.WittVector.Complete
import Mathlib.RingTheory.WittVector.DiscreteValuationRing
import Mathlib.RingTheory.Henselian

noncomputable section
open Polynomial
namespace ZInQBlueprint.ResidueExtension
variable (p : ℕ) [Fact p.Prime]
abbrev IntegralField := WittVector p (QuadraticField p)

def fromPadics : ℤ_[p] →+* IntegralField p :=
  (WittVector.map (algebraMap (ZMod p) (QuadraticField p))).comp (WittVector.equiv p).symm.toRingHom

theorem fromPadics_injective : Function.Injective (fromPadics p) :=
  (WittVector.map_injective _ (algebraMap (ZMod p) (QuadraticField p)).injective).comp (WittVector.equiv p).symm.injective

theorem uniformizer : Irreducible (p : IntegralField p) := WittVector.irreducible p

def residueEquiv : IntegralField p ⧸ Ideal.span {(p : IntegralField p)} ≃+* QuadraticField p :=
  WittVector.quotientPEquiv

/-- The maximal ideal is generated by the same prime as in the base ring. -/
theorem maximalIdeal_eq : IsLocalRing.maximalIdeal (IntegralField p) =
    Ideal.span {(p : IntegralField p)} := (uniformizer p).maximalIdeal_eq

def residueFieldEquiv : IsLocalRing.ResidueField (IntegralField p) ≃+* QuadraticField p :=
  (Ideal.quotEquivOfEq (maximalIdeal_eq p)).trans (residueEquiv p)

@[simp] theorem residueFieldEquiv_apply (x : IntegralField p) :
    residueFieldEquiv p (IsLocalRing.residue _ x) = WittVector.constantCoeff x := rfl

theorem lift_simple_root (f : (IntegralField p)[X]) (r : QuadraticField p)
    (hr : f.eval₂ WittVector.constantCoeff r = 0)
    (hd : f.derivative.eval₂ WittVector.constantCoeff r ≠ 0) :
    ∃! x : IntegralField p, f.IsRoot x ∧ WittVector.constantCoeff x = r := by
  obtain ⟨a, rfl⟩ := WittVector.constantCoeff_surjective p r
  let : HenselianRing (IntegralField p) (IsLocalRing.maximalIdeal _) := by
    rw [maximalIdeal_eq]
    infer_instance
  rw [eval₂_at_apply] at hr hd
  have hzero : f.eval₂ (IsLocalRing.residue _) (IsLocalRing.residue _ a) = 0 := by
    rw [eval₂_at_apply]
    apply (residueFieldEquiv p).injective
    simpa only [residueFieldEquiv_apply, map_zero] using hr
  have hder : f.derivative.eval₂ (IsLocalRing.residue _) (IsLocalRing.residue _ a) ≠ 0 := by
    rw [eval₂_at_apply]
    intro h
    exact hd (by simpa only [residueFieldEquiv_apply, map_zero] using congrArg (residueFieldEquiv p) h)
  obtain ⟨x, ⟨hx, hrx⟩, hu⟩ := HenselTriples.liftSimple_unique f _ hzero hder
  refine ⟨x, ⟨hx, ?_⟩, ?_⟩
  · simpa only [residueFieldEquiv_apply] using congrArg (residueFieldEquiv p) hrx
  · rintro y ⟨hy, hry⟩
    exact hu y ⟨hy, (residueFieldEquiv p).injective (by simpa only [residueFieldEquiv_apply] using hry)⟩

/-- For odd p, a single unramified quadratic ring contains a square root of every
p-adic unit. The quantified scalar may be chosen after the ring. -/
theorem padic_unit_square_root (hp : 2 < p) (u : ℤ_[p]) (hu : IsUnit u) :
    ∃ y : IntegralField p, y^2 = fromPadics p u := by
  let b : ZMod p := WittVector.constantCoeff ((WittVector.equiv p).symm u)
  obtain ⟨r, hr⟩ := square_root p b
  have hc : algebraMap (ZMod p) (QuadraticField p) b =
      WittVector.constantCoeff (fromPadics p u) := rfl
  rw [hc] at hr
  have hunit : IsUnit (WittVector.constantCoeff (fromPadics p u)) :=
    (hu.map (fromPadics p)).map WittVector.constantCoeff
  have hr0 : r ≠ 0 := by
    intro e; rw [e,zero_pow (by decide)] at hr; exact hunit.ne_zero hr.symm
  have htwo : (2 : QuadraticField p) ≠ 0 := by
    change ((2 : ℕ) : QuadraticField p) ≠ 0
    rw [Ne,CharP.cast_eq_zero_iff (QuadraticField p) p]
    exact Nat.not_dvd_of_pos_of_lt (by decide) hp
  let F : (IntegralField p)[X] := X^2-C (fromPadics p u)
  have hz : F.eval₂ WittVector.constantCoeff r = 0 := by simpa [F,sub_eq_zero] using hr
  have coeff_two : (2 : IntegralField p).coeff 0 = 2 :=
    map_ofNat (WittVector.constantCoeff : IntegralField p →+* QuadraticField p) 2
  have hd : F.derivative.eval₂ WittVector.constantCoeff r ≠ 0 := by
    simpa [F,derivative_sub,derivative_pow,coeff_two] using mul_ne_zero htwo hr0
  obtain ⟨y, ⟨hy, _⟩, _⟩ := lift_simple_root p F r hz hd
  exact ⟨y, by simpa [Polynomial.IsRoot,F,sub_eq_zero] using hy⟩

end ZInQBlueprint.ResidueExtension
