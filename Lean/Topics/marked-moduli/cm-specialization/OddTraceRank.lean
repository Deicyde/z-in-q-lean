import DivisorFields
import GaussianSharpness
import Mathlib.Data.Nat.Factorization.Basic
import Mathlib.GroupTheory.GroupAction.FixedPoints

/-! The odd part of the order of a hypothetical torsion point may be cleared
before applying the doubled trace, whose value is the nonzero two-torsion cusp. -/
namespace ZInQBlueprint.TYZ.Specialization
open TensorProduct TraceAction
open scoped TensorProduct
noncomputable section
attribute [local instance] Classical.decEq

/-- The odd part of an annihilator acts as the identity on the cusp and
produces a point in the two-primary subgroup of the same field. -/
theorem infinite_of_cuspTrace {F : SubfieldQ} (hi : Rank.sqrtMinus 1 ∈ F)
    (hF : sqrtDivisor 2 ∉ F) {P : A} (hP : P ∈ pointsOver F)
    {σ : Gal} (hσ : σ (Rank.sqrtMinus 1) = Rank.sqrtMinus 1)
    (htrace : doubledTrace σ P = twiceCusp) : Rank.InfiniteOrder P := by
  intro m hm hkill
  obtain ⟨k,r,hr,hmr⟩ := Nat.exists_eq_two_pow_mul_odd hm.ne'
  have hk : (2^k : ℕ) • (r • P) = 0 := by rwa [←mul_nsmul,Nat.mul_comm,←hmr]
  have hGauss := gaussian_of_twoPower hi hF ((pointsOver F).nsmul_mem hP r) k hk
  obtain ⟨hQ,h4⟩ := gaussian_torsion hGauss
  have hzero := vanishing_of_torsion hσ hQ h4
  have hodd : (r : ℕ) • twiceCusp = twiceCusp := by
    obtain ⟨b,hb⟩ := hr
    rw [hb,add_nsmul,one_nsmul,mul_nsmul,twice_twiceCusp,nsmul_zero,zero_add]
  rw [map_nsmul,htrace,hodd] at hzero
  exact twiceCusp_ne_zero hzero

/-- Row-local CM trace data with the field condition of the final step of
TYZ Lemma 3.18. -/
structure OddRowCM (D : RecursionData) (n : ℕ) : Prop where
  localLaw : ∃ σ : Gal, LocalTraceLaw D σ n
  field : ∃ F : SubfieldQ, Rank.sqrtMinus 1 ∈ F ∧ DivisorTracesOver D n F ∧ sqrtDivisor 2 ∉ F
  characters : ∃ v : ∀ e : ℕ, ℚ ⊗[ℤ] ↥(minusSource e),
    GenusExpansion D (fun e => minusInclusion e (v e)) n

/-- The four-torsion obstruction shows that the earlier full torsion condition
on a fixed field implies the new exclusion of √2. -/
theorem OddRowTraces.toOddRowCM {D : RecursionData} {n : ℕ} (h : OddRowTraces D n) : OddRowCM D n := by
  obtain ⟨hL,⟨F,hi,hZ,ht⟩,hV⟩ := h
  refine ⟨hL,⟨F,hi,hZ,(sqrtTwo_not_mem_iff_four hi).2 ?_⟩,hV⟩
  intro P hP h4
  exact ht ⟨P,hP⟩ (isOfFinAddOrder_iff_nsmul_eq_zero.mpr ⟨4,by decide,h4⟩)

/-- The published positive-rank target from primitive traces, a divisor
trace field omitting √2 and the character expansion. -/
theorem rank_of_cm_odd_rows (D : RecursionData)
    (h1 : D.L 1 = 1) (hc : ClassThreePeriods D.L)
    (rows : ∀ n, n%8=5 → Squarefree n → ZInQ.RouteK.Rank5b.T5bCl n = 1 → OddRowCM D n) :
    ZInQ.RouteK.Rank.CertifiedRankTYZClRk := by
  apply PublicRankJoin.certifiedRank_of_oddClassSumToAntiPoint
  intro n hn hs ho
  obtain ⟨⟨σ,hσ⟩,⟨F,hi,hz,hF⟩,⟨v,hv⟩⟩ := rows n hn hs ho
  have hb := (row_coefficient h1 hc hs hn).trans ho
  have hodd : Odd (traceCoefficient D.L n) := by
    by_contra h
    exact zero_ne_one ((Int.not_odd_iff_even.mp h).intCast_zmod_two.symm.trans hb)
  have hmem := representative_mem_divisorField hi hz n dvd_rfl (Or.inl hn)
  apply antiPoint_of_represents (by omega : 0 < n) _ (represents_of_character_expansion v hv (Or.inl hn))
  apply infinite_of_cuspTrace hi hF hmem hσ.fixesI
  exact (doubled_representative hσ n dvd_rfl (Or.inl hn)).trans (odd_cusp _ hodd)

/-- The field of the divisor traces omits √2 exactly when one absolute
automorphism fixes i and those traces individually and moves √2. The field
may be taken to be the fixed field of the cyclic subgroup generated by it. -/
theorem divisorField_iff_Galois_action (D : RecursionData) (n : ℕ) :
    (∃ F : SubfieldQ, Rank.sqrtMinus 1 ∈ F ∧ DivisorTracesOver D n F ∧ sqrtDivisor 2 ∉ F) ↔
    ∃ κ : Gal, κ (Rank.sqrtMinus 1) = Rank.sqrtMinus 1 ∧
      (∀ e, e ∣ n → (e%8=5 ∨ e%8=7) → sourceAction κ (D.trace e) = D.trace e) ∧
      κ (sqrtDivisor 2) = -sqrtDivisor 2 := by
  have field_fixed (F : SubfieldQ) (a : K) : a ∈ F ↔ ∀ σ ∈ F.fixingSubgroup, σ a = a := by
    conv_lhs => rw [←InfiniteGalois.fixedField_fixingSubgroup F]
    exact IntermediateField.mem_fixedField_iff _ _
  have sq : (sqrtDivisor 2)^2 = 2 := by simpa using sqrtDivisor_sq 2
  have nz : sqrtDivisor 2 ≠ 0 := by intro h; rw [h] at sq; norm_num at sq
  constructor
  · rintro ⟨F,hi,hz,hr⟩
    have hf := mt (field_fixed F (sqrtDivisor 2)).mpr hr
    push Not at hf
    obtain ⟨κ,hκ,hn⟩ := hf
    have hs : (κ (sqrtDivisor 2))^2 = (sqrtDivisor 2)^2 := by rw [←map_pow,sq]; exact map_ofNat κ 2
    exact ⟨κ,(field_fixed _ _).mp hi κ hκ,fun e he hc => hz e he hc κ hκ,
      (sq_eq_sq_iff_eq_or_eq_neg.mp hs).resolve_left hn⟩
  · rintro ⟨κ,hi,hz,hr⟩
    let F : SubfieldQ := IntermediateField.fixedField (Subgroup.zpowers κ)
    have ctx (a : K) : a ∈ F ↔ κ a = a := by
      change a ∈ IntermediateField.fixedField (Subgroup.zpowers κ) ↔ _
      rw [IntermediateField.mem_fixedField_iff]
      constructor
      · intro h; exact h κ (Subgroup.mem_zpowers κ)
      · intro h σ hσ
        obtain ⟨j,rfl⟩ := hσ
        change (κ^j) • a = a
        exact MulAction.mem_fixedBy_zpow (g := κ) (a := a) h j
    refine ⟨F,(ctx _).mpr hi,?_,?_⟩
    · intro e he hc
      have hf := hz e he hc
      cases hP : D.trace e with
      | zero => exact (pointsOver F).zero_mem
      | some x y h =>
        rw [hP] at hf
        change WeierstrassCurve.Affine.Point.some (1^2 * κ x) (1^3 * κ y) _ =
          WeierstrassCurve.Affine.Point.some x y h at hf
        obtain ⟨hx,hy⟩ := WeierstrassCurve.Affine.Point.some.inj hf
        exact (some_mem_pointsOver F x y h).mpr ⟨(ctx _).mpr (by simpa using hx),
          (ctx _).mpr (by simpa using hy)⟩
    · intro h
      have he := (ctx _).mp h
      rw [hr] at he
      exact nz (by linear_combination -he / 2)

/-- The concrete compositum consists of Lₙ(i) and the extended CM fields
of its admissible divisors. Its published exclusion of √2 suffices. -/
theorem rank_of_compositum_omitting_sqrtTwo (S : CMTraces) (L : ℕ → ℤ)
    (eps : ℕ → ℕ → GaussianUnit) (h1 : L 1 = 1) (hc : ClassThreePeriods L)
    (fields : TraceFields (S.recursion L eps) S.extended)
    (rows : ∀ n, n%8=5 → Squarefree n → ZInQ.RouteK.Rank5b.T5bCl n = 1 →
      (∃ σ : Gal, LocalTraceLaw (S.recursion L eps) σ n) ∧
        sqrtDivisor 2 ∉ genusCompositum S.extended n ∧
        ∃ v : ∀ e : ℕ, ℚ ⊗[ℤ] ↥(minusSource e),
          GenusExpansion (S.recursion L eps) (fun e => minusInclusion e (v e)) n) :
    ZInQ.RouteK.Rank.CertifiedRankTYZClRk := by
  apply rank_of_cm_odd_rows (S.recursion L eps) h1 hc
  intro n hn hs ho
  obtain ⟨hl,hF,hv⟩ := rows n hn hs ho
  exact ⟨hl,⟨genusCompositum S.extended n,i_mem_compositum _ _,divisorTracesOver_of_traceFields fields hs (by omega),hF⟩,hv⟩

end
