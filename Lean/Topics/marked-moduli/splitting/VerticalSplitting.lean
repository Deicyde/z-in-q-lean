import LiteralField
import Mathlib.RingTheory.Valuation.RamificationGroup
import Mathlib.RingTheory.Valuation.LocalSubring
import Mathlib.FieldTheory.Separable

/-! Separable reduction and the inertia subgroup of the chosen valuation prolongation. -/
namespace MarkedModuli.Splitting
open Polynomial IntermediateField IsLocalRing

variable (F : Type*) [Field F] {Ω : Type*} [Field Ω] [Algebra F Ω]

/-- Inertia embedded in the ambient algebraic automorphism group, at this prolongation. -/
noncomputable def inertia (v : ValuationSubring Ω) : Subgroup (Ω ≃ₐ[F] Ω) :=
  (v.inertiaSubgroup F).map (v.decompositionSubgroup F).subtype

theorem inertia_residue (v : ValuationSubring Ω) (g : v.decompositionSubgroup F)
    (hg : g ∈ v.inertiaSubgroup F) (z : v) :
    residue v (g • z) = residue v z := by
  have h : MulSemiringAction.toRingAut (v.decompositionSubgroup F) (ResidueField v) g = 1 := hg
  exact DFunLike.congr_fun h (residue v z)

/-- Separable reduction implies that different integral roots have different residues.
The proof counts roots with multiplicity, including where the reduction map is not injective. -/
theorem residue_distinguishes_roots (v : ValuationSubring Ω) (q : v[X]) (hm : q.Monic)
    (hs : (q.map (residue v)).Separable) (a : v) (ha : a ∈ q.roots)
    (b : v) (hb : b ∈ q.roots) (h : residue v a = residue v b) : a = b := by
  have hnodup := Multiset.nodup_of_le (map_roots_le (hm.map (residue v)).ne_zero) (Polynomial.nodup_roots hs)
  exact Multiset.inj_on_of_nodup_map hnodup a ha b hb h

/-- Transport a root into the valuation subring from a monic integral model. -/
theorem model_root (v : ValuationSubring Ω) (p : F[X]) (q : v[X]) (hm : q.Monic)
    (model : p.map (algebraMap F Ω) = q.map (algebraMap v Ω)) (r : p.rootSet Ω) :
    ∃ a : v, (a : Ω) = r ∧ a ∈ q.roots := by
  have hev : (q.map (algebraMap v Ω)).eval (r : Ω) = 0 := by
    rw [← model, eval_map]
    exact (mem_rootSet'.mp r.2).2
  have hi : IsIntegral v (r : Ω) := ⟨q, hm, by rwa [eval₂_eq_eval_map]⟩
  obtain ⟨a, ha⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hi
  refine ⟨a, ha, (mem_roots hm.ne_zero).mpr ?_⟩
  change q.eval a = 0
  apply (show Function.Injective (algebraMap v Ω) from Subtype.val_injective)
  rw [← ha, eval_map, eval₂_at_apply] at hev
  simpa only [map_zero] using hev

/-- A monic integral model with separable reduction makes the *actual*
valuation inertia fix the literal field generated by all geometric roots. -/
theorem inertia_le_rootFixing (v : ValuationSubring Ω) (p : F[X]) (q : v[X]) (hm : q.Monic)
    (model : p.map (algebraMap F Ω) = q.map (algebraMap v Ω))
    (hs : (q.map (residue v)).Separable) :
    inertia F v ≤ (adjoin F (p.rootSet Ω)).fixingSubgroup := by
  rintro g ⟨d, hd, rfl⟩
  apply (mem_fixing_adjoin_iff F Ω _ _).mpr
  intro z hz
  let r : p.rootSet Ω := ⟨z,hz⟩
  obtain ⟨a,ha,har⟩ := model_root F v p q hm model r
  obtain ⟨b,hb,hbr⟩ := model_root F v p q hm model (rootAction F Ω p d.1 r)
  have hda : d • a = b := Subtype.ext (by change d.1 (a : Ω) = b; rw [ha,hb]; rfl)
  have hba : b = a := residue_distinguishes_roots v q hm hs b hbr a har
    (hda ▸ inertia_residue F v d hd a)
  change d.1 z = z
  exact (hb.symm.trans (congrArg Subtype.val hba)).trans ha

/-- A characteristic-zero absolute Galois specialization, at any prolongation of the valuation. -/
theorem absolute_goodReduction (p : F[X]) [CharZero F] (v : ValuationSubring (AlgebraicClosure F))
    (q : v[X]) (hm : q.Monic)
    (model : p.map (algebraMap F (AlgebraicClosure F)) = q.map (algebraMap v (AlgebraicClosure F)))
    (hs : (q.map (residue v)).Separable) :
    p.IsSplittingField F (fixedField (rootAction F (AlgebraicClosure F) p).ker) ∧
      fixedField (rootAction F (AlgebraicClosure F) p).ker ≤ fixedField (inertia F v) := by
  obtain ⟨he, hsplit⟩ := fixedField_rootAction F (AlgebraicClosure F) p (IsAlgClosed.splits _)
  refine ⟨hsplit, ?_⟩
  rw [he]
  intro z hz
  apply (IntermediateField.mem_fixedField_iff _ _).mpr
  exact fun g hg ↦ (IntermediateField.mem_fixingSubgroup_iff _ g).mp
    (inertia_le_rootFixing F v p q hm model hs hg) z hz

end MarkedModuli.Splitting

