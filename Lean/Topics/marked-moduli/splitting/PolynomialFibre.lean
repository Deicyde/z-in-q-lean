import LiteralField
import Mathlib.RingTheory.AdjoinRoot

namespace MarkedModuli.Splitting
open Polynomial IntermediateField

variable {F Ω : Type*} [Field F] [Field Ω] [Algebra F Ω]

/-- Geometric points of the algebra defined by one nonzero polynomial are
its distinct roots, whether or not the chosen equation has multiple roots. -/
noncomputable def pointsEquivRoots (p : F[X]) (hp : p ≠ 0) : Points F Ω (AdjoinRoot p) ≃ p.rootSet Ω where
  toFun x := ⟨x (AdjoinRoot.root p), (mem_rootSet_of_ne hp).mpr (by
    rw [aeval_algHom_apply x, AdjoinRoot.aeval_eq, AdjoinRoot.mk_self, map_zero])⟩
  invFun r := AdjoinRoot.liftAlgHom p (Algebra.ofId F Ω) r (mem_rootSet'.mp r.2).2
  left_inv x := AdjoinRoot.algHom_ext (by simp)
  right_inv r := Subtype.ext (AdjoinRoot.liftAlgHom_root p (Algebra.ofId F Ω) r _)

theorem pointsEquivRoots_equivariant (p : F[X]) (hp : p ≠ 0) (g : Ω ≃ₐ[F] Ω)
    (x : Points F Ω (AdjoinRoot p)) : pointsEquivRoots p hp (pointAction F Ω _ g x) =
      rootAction F Ω p g (pointsEquivRoots p hp x) := rfl

theorem polynomialFibre_kernel (p : F[X]) (hp : p ≠ 0) :
    (pointAction F Ω (AdjoinRoot p)).ker = (rootAction F Ω p).ker := by
  ext g
  rw [MonoidHom.mem_ker, MonoidHom.mem_ker]
  constructor
  · intro h
    apply Equiv.ext
    intro r
    obtain ⟨x, rfl⟩ := (pointsEquivRoots p hp).surjective r
    rw [← pointsEquivRoots_equivariant, h]
    rfl
  · intro h
    apply Equiv.ext
    intro x
    apply (pointsEquivRoots p hp).injective
    rw [pointsEquivRoots_equivariant,h]
    rfl

/-- The field defined from all algebra maps of the polynomial fibre agrees
literally with the embedded field generated by its roots. -/
theorem polynomialFibre_field (p : F[X]) (hp : p ≠ 0) :
    pointField F Ω (AdjoinRoot p) = adjoin F (p.rootSet Ω) := by
  let S := adjoin F (p.rootSet Ω)
  apply le_antisymm
  · apply (pointField_le_iff F Ω _ S).mpr
    intro x a
    obtain ⟨b,rfl⟩ := AdjoinRoot.mk_surjective a
    rw [← AdjoinRoot.aeval_eq, ← aeval_algHom_apply x]
    let aS : S := ⟨x (AdjoinRoot.root p), subset_adjoin F _ ((pointsEquivRoots p hp) x).2⟩
    rw [show aeval (x (AdjoinRoot.root p)) b = S.val (aeval aS b) from aeval_algHom_apply S.val aS b]
    exact (aeval aS b).2
  · apply adjoin_le_iff.mpr
    intro z hz
    obtain ⟨x,hx⟩ := (pointsEquivRoots p hp).surjective (⟨z,hz⟩ : p.rootSet Ω)
    exact subset_adjoin F _ ⟨x, AdjoinRoot.root p, congrArg Subtype.val hx⟩

end MarkedModuli.Splitting

#print axioms MarkedModuli.Splitting.pointsEquivRoots_equivariant
#print axioms MarkedModuli.Splitting.polynomialFibre_kernel
#print axioms MarkedModuli.Splitting.polynomialFibre_field
