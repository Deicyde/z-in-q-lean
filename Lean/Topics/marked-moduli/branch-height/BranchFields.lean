import BranchHeightCriterion
import Mathlib.FieldTheory.PolynomialGaloisGroup
import Mathlib.Data.Fintype.Perm

/-! Nonzero scalar twists have one branch configuration and a bounded ratio field. -/
namespace ZInQBlueprint.BranchHeight
open Polynomial ThetaPeriod SexticThetaHeight SexticIgusaChart
noncomputable section

theorem root_iff_unit_twist {u δ : ℚ} (hu : u ∉ ZInQ.contactSet) (hδ : δ ≠ 0) (r : ℂ) :
    aeval r (sextic u δ) = 0 ↔ aeval r (sextic u 1) = 0 := by
  have h := (unmarked hu hδ).2.1
  have h1 := (unmarked (δ:=1) hu one_ne_zero).2.1
  simp [sextic, map_mul, h, h1]

/-- The height bound may be tested on the same untwisted equation at every parameter. -/
def UntwistedBranchHeight : Prop :=
  ∀ u : ℚ, u ∉ ZInQ.contactSet → ∃ r : Fin 6 → ℂ, Function.Injective r ∧
    (∀ i, aeval (r i) (sextic u 1) = 0) ∧
    ∃ (K : Type) (_ : Field K) (_ : NumberField K) (φ : K →+* ℂ) (v : Fin 10 → K),
      (∀ i, φ (v i) = branchRatio r i) ∧
      ThetaQuotient.normalizedHeight v ≤ 2^26 * max 1 (HeightBudget.vonKaenelBudget u)

theorem untwisted_iff : UntwistedBranchHeight ↔ BoundedBranchHeight := by
  constructor <;> intro h u hu <;> obtain ⟨r,hi,hz,H⟩ := h u hu
  · exact ⟨r,hi,fun i => (root_iff_unit_twist hu (by exact_mod_cast (GlobalTwist.delta_pos u).ne') _).mpr (hz i),H⟩
  · exact ⟨r,hi,fun i => (root_iff_unit_twist hu (by exact_mod_cast (GlobalTwist.delta_pos u).ne') _).mp (hz i),H⟩

theorem weightField_le {L : IntermediateField ℚ ℂ} {r : Fin 6 → ℂ} (hr : ∀ i, r i ∈ L) :
    weightField r ≤ L := by
  apply IntermediateField.adjoin_le_iff.mpr
  rintro _ ⟨i,rfl⟩
  have hfin (j : Fin 5) : finiteBranches r j ∈ L :=
    L.inv_mem (L.sub_mem (hr _) (hr _))
  have hdiff (S : Finset (Fin 5)) : differences (finiteBranches r) S ∈ L :=
    L.prod_mem (fun a _ => L.prod_mem fun b _ => L.sub_mem (hfin a) (hfin b))
  have hbranch (T : Partition) : branchValue (finiteBranches r) T ∈ L :=
    L.pow_mem (L.mul_mem (hdiff T.val) (hdiff (Finset.univ \ T.val))) 2
  exact L.div_mem (hbranch _) (hbranch _)

/-- Bound the field generated by the ratios by the order of the permutation group of the roots. -/
theorem weightField_degree {f : ℚ[X]} (hf : f.Separable) (h0 : f ≠ 0)
    {r : Fin 6 → ℂ} (hr : ∀ i, aeval (r i) f = 0) :
    Module.finrank ℚ (weightField r) ≤ f.natDegree.factorial := by
  classical
  let L := IntermediateField.adjoin ℚ (f.rootSet ℂ)
  have hl : weightField r ≤ L := weightField_le (fun i =>
    IntermediateField.subset_adjoin ℚ _ (mem_rootSet.mpr ⟨h0, hr i⟩))
  let : IsSplittingField ℚ L f := IntermediateField.adjoin_rootSet_isSplittingField (IsAlgClosed.splits _)
  let : FiniteDimensional ℚ L := IsSplittingField.finiteDimensional L f
  let : Fact ((f.map (algebraMap ℚ ℂ)).Splits) := ⟨IsAlgClosed.splits _⟩
  calc
    Module.finrank ℚ (weightField r) ≤ Module.finrank ℚ L :=
      LinearMap.finrank_le_finrank_of_injective (f := (IntermediateField.inclusion hl).toLinearMap) (IntermediateField.inclusion hl).injective
    _ = Module.finrank ℚ f.SplittingField := (IsSplittingField.algEquiv L f).toLinearEquiv.finrank_eq
    _ = Fintype.card f.Gal := by rw [← Gal.card_of_separable hf, Nat.card_eq_fintype_card]
    _ ≤ Fintype.card (Equiv.Perm (f.rootSet ℂ)) := Fintype.card_le_of_injective _ (Gal.galActionHom_injective f ℂ)
    _ = (Fintype.card (f.rootSet ℂ)).factorial := Fintype.card_perm
    _ ≤ f.natDegree.factorial := Nat.factorial_le (by rw [Set.fintypeCard_eq_ncard]; exact f.ncard_rootSet_le ℂ)

theorem paper_weightField_degree {u δ : ℚ} (hu : u ∉ ZInQ.contactSet) (hδ : δ ≠ 0)
    {r : Fin 6 → ℂ} (hr : ∀ i, aeval (r i) (sextic u δ) = 0) :
    Module.finrank ℚ (weightField r) ≤ 720 := by
  let f := sextic u δ
  obtain ⟨hd, hdisc⟩ := smooth_sextic hu hδ
  have hpos : 0 < f.natDegree := by change 0 < (sextic u δ).natDegree; omega
  have hf : f ≠ 0 := fun h => Nat.ne_of_gt hpos (by simp [h])
  have hres : resultant f f.derivative ≠ 0 := by
    rw [natDegree_derivative, resultant_deriv (natDegree_pos_iff_degree_pos.mp hpos)]
    exact mul_ne_zero (mul_ne_zero (pow_ne_zero _ (by norm_num)) (leadingCoeff_ne_zero.mpr hf)) hdisc
  have hsep : f.Separable := by
    change IsCoprime f f.derivative
    by_contra h
    exact hres (resultant_eq_zero_iff.mpr ⟨Or.inl hf,h⟩)
  exact (weightField_degree hsep hf hr).trans (by change (sextic u δ).natDegree.factorial ≤ 720; rw [hd]; decide)

end
