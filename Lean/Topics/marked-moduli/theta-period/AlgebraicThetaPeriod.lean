import SexticThetaHeight
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.Data.Set.Finite.Range

/-! An algebraic level-two theta null on the chart of its first even coordinate.
Only ratios, hence no common analytic scale, need be algebraic. -/
namespace ZInQBlueprint.ThetaPeriod
open ThetaQuotient SexticThetaHeight SexticInvariants
noncomputable section

abbrev Tuple := Fin 16 → ℂ
def chart (z : Tuple) : Tuple := fun i => z i / z (evenIndices 0)
def pct (z : Tuple) : ℂ := ∏ i, z (evenIndices i)
def psi (z : Tuple) : ℂ := ∑ i, z (evenIndices i)^8
def absInvariant (z : Tuple) : ℂ := (psi z)^5/(pct z)^4

theorem chart_pivot {z : Tuple} (h : pct z ≠ 0) : z (evenIndices 0) ≠ 0 := by
  intro e
  exact h (Finset.prod_eq_zero (Finset.mem_univ 0) e)

theorem chart_scale (z : Tuple) {c : ℂ} (hc : c ≠ 0) : chart (c • z) = chart z := by
  funext i
  simp only [chart, Pi.smul_apply, smul_eq_mul]
  exact mul_div_mul_left _ _ hc

theorem pct_scale (c : ℂ) (z : Tuple) : pct (c • z) = c^10*pct z := by
  simp [pct, Finset.prod_mul_distrib]

theorem psi_scale (c : ℂ) (z : Tuple) : psi (c • z) = c^8*psi z := by
  simp [psi,mul_pow,Finset.mul_sum]

theorem invariant_scale (z : Tuple) {c : ℂ} (hc : c ≠ 0) :
    absInvariant (c • z) = absInvariant z := by
  unfold absInvariant
  rw [pct_scale,psi_scale,mul_pow,mul_pow,show (c^8)^5=(c^10)^4 by ring]
  exact mul_div_mul_left _ _ (pow_ne_zero _ (pow_ne_zero _ hc))

private theorem chart_eq_smul (z : Tuple) : chart z = (z (evenIndices 0))⁻¹ • z := by
  funext i
  simp [chart,div_eq_inv_mul]

theorem chart_nondegenerate {z : Tuple} (hz : pct z ≠ 0) : pct (chart z) ≠ 0 := by
  rw [chart_eq_smul,pct_scale]
  exact mul_ne_zero (pow_ne_zero _ (inv_ne_zero (chart_pivot hz))) hz

theorem invariant_chart {z : Tuple} (hz : pct z ≠ 0) : absInvariant (chart z) = absInvariant z := by
  rw [chart_eq_smul,invariant_scale z (inv_ne_zero (chart_pivot hz))]

/-- The field generated by this affine representative is an actual subfield of ℂ. -/
def fieldOf (a : Tuple) := IntermediateField.adjoin ℚ (Set.range a)

theorem numberField (a : Tuple) (ha : ∀ i, IsAlgebraic ℚ (a i)) : NumberField (fieldOf a) := by
  let _ : FiniteDimensional ℚ (fieldOf a) := IntermediateField.finiteDimensional_adjoin (by
    rintro x ⟨i,rfl⟩
    exact (ha i).isIntegral)
  exact NumberField.of_module_finite ℚ _

def coordinates (a : Tuple) (i : Fin 16) : fieldOf a :=
  ⟨a i, IntermediateField.subset_adjoin ℚ _ (Set.mem_range_self i)⟩

theorem coordinates_embed (a : Tuple) (i : Fin 16) : ((coordinates a i : fieldOf a) : ℂ) = a i := rfl

/-- The least complex number field on this fixed chart. -/
theorem fieldOf_le_iff (a : Tuple) (L : IntermediateField ℚ ℂ) :
    fieldOf a ≤ L ↔ ∀ i, a i ∈ L := by
  rw [fieldOf, IntermediateField.adjoin_le_iff]
  exact Set.range_subset_iff

private def heightOf (a : Tuple) (ha : ∀ i, IsAlgebraic ℚ (a i)) : ℝ :=
  letI := numberField a ha
  euclideanHeight (coordinates a)

/-- Absolute Euclidean height on the algebraic projective chart with θ₀ ≠ 0. -/
def chartHeight (z : Tuple) (ha : ∀ i, IsAlgebraic ℚ (chart z i)) : ℝ :=
  heightOf (chart z) ha

theorem chartHeight_scale (z : Tuple) {c : ℂ} (hc : c ≠ 0)
    (ha : ∀ i, IsAlgebraic ℚ (chart z i)) :
    chartHeight (c • z) (by rwa [chart_scale z hc]) = chartHeight z ha := by
  unfold chartHeight; congr 1; exact chart_scale z hc

/-- Analytic statements about the same null point and the same Faltings height.
The number field of definition, embedding, and choice of algebraic representatives
are all supplied by the chart construction. -/
structure AnalyticPeriodData (u δ : ℚ) where
  null : Tuple
  algebraic : ∀ i, IsAlgebraic ℚ (chart null i)
  evenProduct : pct null ≠ 0
  period : absInvariant null = ((igusaI4 (sextic u δ)^5/(sextic u δ).discr^2 : ℚ) : ℂ)
  stable : ℝ
  comparison : |max 1 (chartHeight null algebraic) - max 1 (stable + Real.log Real.pi)/2| ≤
    ThetaMetric.pazukiConstant * Real.log (min (max 1 (chartHeight null algebraic))
      (max 1 (stable + Real.log Real.pi)) + 2)
  reduction : stable ≤ HeightBudget.vonKaenelBudget u

def periodData {u δ : ℚ} (f : AnalyticPeriodData u δ) :
    @PeriodData (fieldOf (chart f.null)) _ (numberField _ f.algebraic) u δ := by
  letI := numberField _ f.algebraic
  refine {
    coordinates := coordinates (chart f.null)
    embedding := (fieldOf (chart f.null)).val.toRingHom
    evenProduct := ?_
    period := ?_
    stable := f.stable
    comparison := f.comparison
    reduction := f.reduction }
  · exact chart_nondegenerate f.evenProduct
  · exact (invariant_chart f.evenProduct).trans f.period

def HasAnalyticPeriods : Prop := ∀ u : ℚ, u ∉ ZInQ.contactSet →
  ∃ δ : ℚ, δ ≠ 0 ∧ Nonempty (AnalyticPeriodData u δ)

theorem sexticPeriods_of_analyticPeriods (h : HasAnalyticPeriods) : HasSexticPeriods := by
  intro u hu
  obtain ⟨δ,hδ,⟨f⟩⟩ := h u hu
  exact ⟨δ,hδ,fieldOf (chart f.null),_,numberField _ f.algebraic,⟨periodData f⟩⟩

end
end ZInQBlueprint.ThetaPeriod
