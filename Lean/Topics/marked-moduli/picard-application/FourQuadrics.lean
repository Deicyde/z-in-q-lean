import ProjectiveCharts
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal
import Mathlib.Tactic.FinCases

/-! The homogeneous ideal of the four quadrics of a binary sextic in projective four-space. -/
open MvPolynomial
namespace ZInQBlueprint.SexticEmbedding
noncomputable section
variable {R : Type} [CommRing R]
attribute [local instance] MvPolynomial.gradedAlgebra

/-- The three minors of the cubic Veronese matrix and the square of the fifth coordinate. -/
def generators (c : Fin 7 → R) (v : Fin 5 → R) : Fin 4 → R :=
  ![v 0*v 2-v 1^2,v 0*v 3-v 1*v 2,v 1*v 3-v 2^2,
    v 4^2-quadratic c (v 0) (v 1) (v 2) (v 3)]

theorem generators_vanish (c : Fin 7 → R) (v : Fin 5 → R) :
    (∀ j, generators c v j = 0) ↔ equations c (v 0) (v 1) (v 2) (v 3) (v 4) := by
  constructor
  · intro h
    exact ⟨sub_eq_zero.mp (h 0),sub_eq_zero.mp (h 1),sub_eq_zero.mp (h 2),sub_eq_zero.mp (h 3)⟩
  · rintro ⟨e₀,e₁,e₂,e₃⟩ j
    fin_cases j
    · exact sub_eq_zero.mpr e₀
    · exact sub_eq_zero.mpr e₁
    · exact sub_eq_zero.mpr e₂
    · exact sub_eq_zero.mpr e₃

abbrev Variables (R : Type) [CommRing R] := MvPolynomial (Fin 5) R

/-- The homogeneous equations in the standard graded polynomial ring. -/
def quadrics (c : Fin 7 → R) : Fin 4 → Variables R := generators (C ∘ c) X

theorem map_generators {S : Type} [CommRing S] (φ : R →+* S) (c : Fin 7 → R) (v : Fin 5 → R)
    (j : Fin 4) : φ (generators c v j) = generators (φ ∘ c) (φ ∘ v) j := by
  fin_cases j <;> simp [generators,quadratic]

theorem eval_quadrics {S : Type} [CommRing S] [Algebra R S] (c : Fin 7 → R) (v : Fin 5 → S)
    (j : Fin 4) : aeval v (quadrics c j) = generators (algebraMap R S ∘ c) v j := by
  fin_cases j <;> simp [quadrics,generators,quadratic]

theorem quadrics_homogeneous (c : Fin 7 → R) (j : Fin 4) : IsHomogeneous (quadrics c j) 2 := by
  have prod (a b : Fin 5) : IsHomogeneous (X a*X b : Variables R) 2 :=
    (isHomogeneous_X R a).mul (isHomogeneous_X R b)
  have sq (a : Fin 5) : IsHomogeneous (X a^2 : Variables R) 2 := isHomogeneous_X_pow a 2
  fin_cases j
  · exact (prod 0 2).sub (sq 1)
  · exact (prod 0 3).sub (prod 1 2)
  · exact (prod 1 3).sub (sq 2)
  · change IsHomogeneous ((X 4 : Variables R)^2 - _) 2
    apply (sq 4).sub
    unfold quadratic
    simp only [Function.comp_apply,mul_assoc]
    exact (((((((sq 3).C_mul (c 0)).add ((prod 2 3).C_mul (c 1))).add
      ((prod 1 3).C_mul (c 2))).add ((prod 0 3).C_mul (c 3))).add
      ((prod 0 2).C_mul (c 4))).add ((prod 0 1).C_mul (c 5))).add ((sq 0).C_mul (c 6))

/-- The actual homogeneous ideal generated by the four specified polynomials. -/
def equationsIdeal (c : Fin 7 → R) : HomogeneousIdeal (homogeneousSubmodule (Fin 5) R) :=
  ⟨Ideal.span (Set.range (quadrics c)), Ideal.homogeneous_span _ _ (by
    rintro _ ⟨j,rfl⟩
    exact ⟨2,quadrics_homogeneous c j⟩)⟩

end
end ZInQBlueprint.SexticEmbedding
#print axioms ZInQBlueprint.SexticEmbedding.generators_vanish
#print axioms ZInQBlueprint.SexticEmbedding.eval_quadrics
#print axioms ZInQBlueprint.SexticEmbedding.quadrics_homogeneous
#print axioms ZInQBlueprint.SexticEmbedding.equationsIdeal
