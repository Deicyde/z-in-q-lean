import SheafComparison
import Mathlib.CategoryTheory.Sites.SheafCohomology.MayerVietoris
import Mathlib.Topology.Sheaves.MayerVietoris

/-! Global sheaf cohomology is objectwise cohomology at a terminal object of a site. -/
open CategoryTheory CategoryTheory.Limits CategoryTheory.Abelian Opposite
namespace ZInQBlueprint.BinaryCover.Cech
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable {C : Type} [Category.{0} C] (J : GrothendieckTopology C)
  [HasSheafify J AddCommGrpCat.{0}] [HasExt.{0} (Sheaf J AddCommGrpCat.{0})]

/-- The presheaf freely generated by a terminal object is the constant presheaf on Z. -/
def terminalGenerators {T : C} (hT : IsTerminal T) :
    yoneda.obj T ⋙ AddCommGrpCat.free ≅ (Functor.const Cᵒᵖ).obj (AddCommGrpCat.of (ULift.{0} ℤ)) := by
  letI (i : Cᵒᵖ) : Unique (i.unop ⟶ T) := ⟨⟨hT.from _⟩, fun j => hT.hom_ext _ _⟩
  refine NatIso.ofComponents (fun i => ((FreeAbelianGroup.uniqueEquiv (i.unop ⟶ T)).trans
    AddEquiv.ulift.symm).toAddCommGrpIso) ?_
  intro i j e
  apply AddCommGrpCat.hom_ext
  apply FreeAbelianGroup.lift_ext
  intro q
  change (ULift.up ((FreeAbelianGroup.uniqueEquiv _)
    (FreeAbelianGroup.of (e.unop ≫ q))) : ULift ℤ) = ULift.up ((FreeAbelianGroup.uniqueEquiv _)
      (FreeAbelianGroup.of q))
  simp [FreeAbelianGroup.uniqueEquiv]

/-- Sheafification identifies the representable abelian generator at T with constant Z. -/
def terminalGeneratorIso {T : C} (hT : IsTerminal T) :
    (presheafToSheaf J AddCommGrpCat).obj (yoneda.obj T ⋙ AddCommGrpCat.free) ≅
      (constantSheaf J AddCommGrpCat).obj (AddCommGrpCat.of (ULift.{0} ℤ)) :=
  (presheafToSheaf J _).mapIso (terminalGenerators hT)

/-- The isomorphism is a natural transformation in the sheaf, in every degree. -/
def terminalCohomologyNatIso {T : C} (hT : IsTerminal T) (n : ℕ) :
   (Sheaf.cohomologyPresheafFunctor J n ⋙ (evaluation _ _).obj (op T)) ≅ Sheaf.functorH J n :=
  (extFunctor n).mapIso (terminalGeneratorIso J hT).symm.op

/-- Absolute cohomology of a sheaf is its cohomology evaluated at a terminal object. -/
def terminalCohomology {T : C} (hT : IsTerminal T) (F : Sheaf J AddCommGrpCat) (n : ℕ) :
    F.H' n T ≃+ F.H n :=
  ((terminalCohomologyNatIso J hT n).app F).addCommGroupIsoToAddEquiv

theorem terminalCohomology_natural {T : C} (hT : IsTerminal T) {F G : Sheaf J AddCommGrpCat}
    (a : F ⟶ G) (n : ℕ) (x : F.H' n T) :
    terminalCohomology J hT G n (((Sheaf.cohomologyPresheafFunctor J n).map a).app (op T) x)
      = Sheaf.H.map a n (terminalCohomology J hT F n x) :=
  congrArg (fun φ => φ x) ((terminalCohomologyNatIso J hT n).hom.naturality a)

end
end ZInQBlueprint.BinaryCover.Cech
#print axioms ZInQBlueprint.BinaryCover.Cech.terminalGenerators
#print axioms ZInQBlueprint.BinaryCover.Cech.terminalCohomology
#print axioms ZInQBlueprint.BinaryCover.Cech.terminalCohomology_natural
