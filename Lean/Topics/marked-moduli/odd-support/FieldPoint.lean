import FixedCover
import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-! A point on one fixed curve over the literal subfield generated by a
square root of the signed kernel. -/
open Polynomial ZInQ
namespace ZInQBlueprint.OddSupport
noncomputable section
local notation "Ω" => AlgebraicClosure ℚ

theorem point_over_square_root {K : Type*} [Field K] [Algebra ℚ K]
    {d : ℤ} {x y : ℚ} (h : 30*(d:ℚ)*y^2=quintic x) {s : K}
    (hs : s^2 = (d:K)) :
    30*(s * algebraMap ℚ K y)^2 = quintic (algebraMap ℚ K x) := by
  have hh := congrArg (algebraMap ℚ K) h
  simpa only [quintic,map_mul,map_sub,map_pow,map_one,map_ofNat,map_intCast,
    mul_pow,hs,mul_assoc] using hh

theorem root_field_degree {s : Ω} {d : ℤ} (hs : s^2=(d:Ω)) :
    Module.finrank ℚ (IntermediateField.adjoin ℚ ({s} : Set Ω)) ≤ 2 := by
  let P : ℚ[X] := Polynomial.X^2 - C (d:ℚ)
  have mon : P.Monic := monic_X_pow_sub_C (d:ℚ) (by decide)
  have z : aeval s P=0 := by simp [P,hs]
  rw [IntermediateField.adjoin.finrank (show IsIntegral ℚ s from ⟨P,mon,z⟩)]
  have deg : P.natDegree=2 := natDegree_X_pow_sub_C
  exact (natDegree_le_natDegree (minpoly.min ℚ s mon z)).trans_eq deg

/-- The curve is independent of d. The subfield and its square root are
explicitly linked to the same d that is controlled by contactSupport. -/
theorem fixed_curve_point {u : ℚ} (hu : u ∉ contactSet) (S : Finset ℕ) :
    ∃ (d : ℤ) (s : Ω), Squarefree d ∧ d ≠ 0 ∧ s^2 = (d:Ω) ∧
      d.natAbs ∣ (∏ p ∈ S,p)*contactSupport S u ∧
      (∀ p : ℕ, p.Prime → p ∉ S → 5<p → (p ∣ d.natAbs ↔ p ∣ contactSupport S u)) ∧
      let L := IntermediateField.adjoin ℚ ({s} : Set Ω)
      Module.finrank ℚ L ≤ 2 ∧
      ∃ (x : ℚ) (y : L), y ≠ 0 ∧ x≠5 ∧ 120/(x-5)=u ∧
        30*y^2=quintic (algebraMap ℚ L x) := by
  obtain ⟨d,x,y,sf,nd,pr,pt,ny,nx,inv,good⟩ := fixed_twist_reduction hu S
  obtain ⟨s,hs⟩ := IsAlgClosed.exists_pow_nat_eq (d:Ω) (by decide : 0<2)
  let L := IntermediateField.adjoin ℚ ({s} : Set Ω)
  let root : L := ⟨s, IntermediateField.subset_adjoin _ _ (Set.mem_singleton _)⟩
  have hs' : root^2=(d:L) := by apply Subtype.ext; exact hs
  have nz : root≠0 := by intro z; rw [z,zero_pow (by decide)] at hs'; exact nd (by exact_mod_cast hs'.symm)
  refine ⟨d,s,sf,nd,hs,pr,good,root_field_degree hs,x,root*algebraMap ℚ L y,
    mul_ne_zero nz (by simpa only [map_zero] using (algebraMap ℚ L).injective.ne ny),nx,inv,point_over_square_root pt hs'⟩

#print axioms point_over_square_root
#print axioms root_field_degree
#print axioms fixed_curve_point
end
end ZInQBlueprint.OddSupport
