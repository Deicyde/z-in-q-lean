import QuaternionOrder
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-! The actual quotient of the integral coordinate order, its radical and residue norm. -/
namespace ZInQBlueprint.LevelThree

def orderEmbedding : O →+* B where
  toFun := embed
  map_mul' := embed_mul
  map_one' := by ext <;> norm_num [embed]
  map_zero' := by ext <;> norm_num [embed]
  map_add' x y := by ext <;> simp [embed] <;> push_cast <;> ring

def reduction : O →+* O₃ where
  toFun := reduceO
  map_mul' := reduceO_mul
  map_one' := rfl
  map_zero' := rfl
  map_add' x y := by ext <;> simp [reduceO]

theorem reduction_surjective : Function.Surjective reduction := by
  rintro ⟨a,b,c,d⟩
  obtain ⟨aa, rfl⟩ := ZMod.intCast_surjective a
  obtain ⟨bb, rfl⟩ := ZMod.intCast_surjective b
  obtain ⟨cc, rfl⟩ := ZMod.intCast_surjective c
  obtain ⟨dd, rfl⟩ := ZMod.intCast_surjective d
  exact ⟨⟨aa,bb,cc,dd⟩,rfl⟩

theorem reduction_ker : RingHom.ker reduction = Ideal.span ({(3:O)} : Set O) := by
  apply le_antisymm
  · intro x hx
    obtain ⟨⟨a,ha⟩,⟨b,hb⟩,⟨c,hc⟩,⟨d,hd⟩⟩ := (reduce_kernel x).mp hx
    rw [Ideal.mem_span_singleton']
    refine ⟨⟨a,b,c,d⟩,?_⟩
    change (⟨a,b,c,d⟩:O)*(⟨3,0,0,0⟩:O) = x
    ext <;> simp [ha,hb,hc,hd,mul_comm]
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    change reduceO (3:O) = 0
    rfl

instance : (Ideal.span ({(3:O)} : Set O)).IsTwoSided := by
  rw [← reduction_ker]
  infer_instance

/-- A ring equivalence for the literal quotient by the principal ideal generated by three. -/
noncomputable def quotientThree : (O ⧸ Ideal.span ({(3:O)} : Set O)) ≃+* A :=
  ((Ideal.quotEquivOfEq reduction_ker.symm).trans
    (RingHom.quotientKerEquivOfSurjective reduction_surjective)).trans standardEquiv

def residueHom : A →+* K where
  toFun := residual
  map_one' := rfl
  map_zero' := rfl
  map_add' := by intro x y; ext <;> rfl
  map_mul' x y := by ext <;> simp [residual] <;> ring

theorem unit_iff_residue (x : A) : IsUnit x ↔ residual x ≠ 0 := by
  rw [unit_iff]
  exact not_congr QuadraticAlgebra.norm_eq_zero_iff_eq_zero

theorem residue_norm (x : A) : algebraMap F K (nrd x) = (residual x)^4 := by
  rw [nrd, QuadraticAlgebra.algebraMap_norm_eq_mul_star, ← frobenius]; ring

abbrev radical := RingHom.ker residueHom

def radicalEquiv : radical ≃ K where
  toFun x := radicalPart x.val
  invFun b := ⟨assemble 0 b,rfl⟩
  left_inv x := by
    apply Subtype.ext
    have h : residual x.val = 0 := x.property
    have ha := congrArg QuadraticAlgebra.re h
    have hb := congrArg QuadraticAlgebra.im h
    exact QuaternionAlgebra.ext ha.symm hb.symm rfl rfl
  right_inv b := by cases b; rfl

theorem radical_card : Nat.card radical = 9 := (Nat.card_congr radicalEquiv).trans field_card

theorem radical_square_zero (x y : A) (hx : x ∈ radical) (hy : y ∈ radical) : x*y = 0 := by
  change residual x = 0 at hx
  change residual y = 0 at hy
  have he (v:A) : assemble (residual v) (radicalPart v) = v := rfl
  rw [← he x, ← he y, skew_product,hx,hy]
  simp [assemble]
  rfl

theorem pairing_add_left (x y z : A) : pairing (x+y) z = pairing x z + pairing y z := by
  simp [pairing,add_mul]; ring

theorem pairing_add_right (x y z : A) : pairing x (y+z) = pairing x y + pairing x z := by
  simp [pairing,mul_add]; ring

#print axioms orderEmbedding
#print axioms reduction_surjective
#print axioms reduction_ker
#print axioms quotientThree
#print axioms unit_iff_residue
#print axioms residue_norm
#print axioms radical_card
#print axioms radical_square_zero
#print axioms pairing_add_left
#print axioms pairing_add_right
end ZInQBlueprint.LevelThree
