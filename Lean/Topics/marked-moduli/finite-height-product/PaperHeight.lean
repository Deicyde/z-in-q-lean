import GlobalBranchHeight
import AllFinitePlaces
import ActualUnitCounterexample

/-! Absolute projective height of the ten coordinates of the rational sextic. -/
namespace ZInQBlueprint.BranchDepth
open Polynomial BranchHeight SexticThetaHeight ThetaQuotient
noncomputable section

/-- The normalized projective height of every smooth member is bounded by its pole form. -/
theorem paper_branch_height {u δ : ℚ} (hu : u ∉ ZInQ.contactSet) (hδ : δ ≠ 0)
    {r : Fin 6 → ℂ} (hr : Function.Injective r) (hz : ∀ i, aeval (r i) (sextic u δ) = 0) :
    letI := weight_numberField hu hδ hz
    normalizedHeight (weights r) < 49 + Real.log 8503056 + 6 * Real.log (poleNorm u) := by
  let := weight_numberField hu hδ hz
  exact paper_height_of_pole_denominator hu hδ hr hz (NonarchContact.finite_place_bound hu hδ hr hz)

private theorem absolute_constant : Real.log 8503056 + 6 * Real.log 3907 < 66 := by
  have lo : (2718 / 1000 : ℝ) < Real.exp 1 := by linarith [Real.exp_one_gt_d9]
  have hp : (2718 / 1000 : ℝ)^66 < (Real.exp 1)^66 :=
    pow_lt_pow_left₀ lo (by norm_num) (by norm_num)
  have h : Real.log ((8503056:ℝ)*3907^6) < 66 := by
    apply (Real.log_lt_iff_lt_exp (by norm_num : 0 < (8503056:ℝ)*3907^6)).mpr
    calc (8503056:ℝ)*3907^6 < (2718/1000:ℝ)^66 := by norm_num
         _ < (Real.exp 1)^66 := hp
         _ = Real.exp 66 := by rw [← Real.exp_nat_mul]; norm_num
  rw [Real.log_mul (by norm_num) (by norm_num),Real.log_pow] at h
  exact h

/-- The absolute bound in the logarithmic projective height of the rational input. -/
theorem paper_branch_height_input {u δ : ℚ} (hu : u ∉ ZInQ.contactSet) (hδ : δ ≠ 0)
    {r : Fin 6 → ℂ} (hr : Function.Injective r) (hz : ∀ i, aeval (r i) (sextic u δ) = 0) :
    letI := weight_numberField hu hδ hz
    normalizedHeight (weights r) < 115 + 12 * ZInQ.ratHeight u := by
  let := weight_numberField hu hδ hz
  have h := paper_height_of_input_denominator hu hδ hr hz (NonarchContact.finite_place_bound hu hδ hr hz)
  linarith [absolute_constant]

/-- There is a root labeling realizing the branch-height bound at every unmarked input and
nonzero twist. The number field is generated by the projective coordinates. -/
theorem exists_paper_branch_height {u δ : ℚ} (hu : u ∉ ZInQ.contactSet) (hδ : δ ≠ 0) :
    ∃ (r : Fin 6 → ℂ) (_ : Function.Injective r) (hz : ∀ i, aeval (r i) (sextic u δ) = 0),
      letI := weight_numberField hu hδ hz
      normalizedHeight (weights r) < 115 + 12 * ZInQ.ratHeight u := by
  obtain ⟨r,hr,hz⟩ := UnitObstruction.paper_roots hu hδ
  exact ⟨r,hr,hz,paper_branch_height_input hu hδ hr hz⟩

end
end ZInQBlueprint.BranchDepth
#print axioms ZInQBlueprint.BranchDepth.paper_branch_height
#print axioms ZInQBlueprint.BranchDepth.paper_branch_height_input
#print axioms ZInQBlueprint.BranchDepth.exists_paper_branch_height
