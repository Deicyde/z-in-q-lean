def value (weighted : Bool) (z : Fin 262 → ℚ) : ℚ :=
  squares weighted (rows.map (fun r => (r.1, (r.2.map (term z)).sum)))

def image (weighted : Bool) (q : ℚ) : Prop :=
  ∃ z : Fin 262 → ℚ, z 0 = q ∧ value weighted z = 0

theorem same_zeros (z : Fin 262 → ℚ) : value true z = 0 ↔ value false z = 0 :=
  change_weights _

theorem same_projection (q : ℚ) : image true q ↔ image false q := by
  simp only [image, same_zeros]

theorem defines_of_parent (parent : ∀ q : ℚ, image false q ↔ ∃ n : ℤ, q = n) :
    ∀ q : ℚ, image true q ↔ ∃ n : ℤ, q = n :=
  fun q => (same_projection q).trans (parent q)

end Quartic262
