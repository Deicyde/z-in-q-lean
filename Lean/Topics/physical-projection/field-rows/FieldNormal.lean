def weight : List Nat→Int | [] => 1 | i::m => dilate i*weight m
def inflate (p : Polynomial) : Polynomial := p.map fun t => ⟨t.coefficient*weight t.monomial,t.monomial⟩
theorem inflate_value (z : Assignment) (p : Polynomial) : value z (inflate p)=value (shifted z) p := by
  have mon (m : List Nat) : monomialValue (shifted z) m=(weight m:Rat)*monomialValue z m := by
    induction m with
    | nil => simp [monomialValue,weight]
    | cons i m ih => simp only [monomialValue,weight,shifted,Rat.intCast_mul,ih];grobner
  induction p with
  | nil => rfl
  | cons t ts ih => change _ * monomialValue z t.monomial + value z (inflate ts) = _
                    simp only [Rat.intCast_mul,value,termValue,mon,ih];grobner

