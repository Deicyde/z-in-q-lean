import QuaternionOrder

/-! A rational algebra containing the discriminant-six quaternions is
generated by those quaternions and their centralizer. -/
namespace ZInQBlueprint.LevelThree.IntegralOrder
open QuaternionAlgebra
noncomputable section

def unitI : Bˣ where
  val := ⟨0,1,0,0⟩
  inv := ⟨0,1/2,0,0⟩
  val_inv := by ext <;> norm_num
  inv_val := by ext <;> norm_num

def unitJ : Bˣ where
  val := ⟨0,0,1,0⟩
  inv := ⟨0,0,-1/3,0⟩
  val_inv := by ext <;> norm_num
  inv_val := by ext <;> norm_num

variable {D : Type*} [Ring D] [Algebra ℚ D]

private def adj (f : B →ₐ[ℚ] D) (u : Bˣ) : D →ₐ[ℚ] D where
  toFun x := f (u:B)*x*f (↑u⁻¹:B)
  map_zero' := by simp
  map_one' := by simp [←map_mul]
  map_add' x y := by simp [mul_add,add_mul]
  map_mul' x y := by
    have h : f (↑u⁻¹:B)*f (u:B) = 1 := by rw [←map_mul,Units.inv_mul,map_one]
    change f (u:B)*(x*y)*f (↑u⁻¹:B) = _
    calc
      _ = f (u:B)*(x*(f (↑u⁻¹:B)*f (u:B))*y)*f (↑u⁻¹:B) := by rw [h,mul_one]
      _ = _ := by simp only [mul_assoc]
  commutes' t := by
    change f (u:B)*algebraMap ℚ D t*f (↑u⁻¹:B) = _
    rw [←Algebra.commutes t (f (u:B)),mul_assoc,←map_mul,Units.mul_inv,map_one,mul_one]

private theorem adj_comp_apply (f : B →ₐ[ℚ] D) (u v : Bˣ) (x : D) :
    adj f u (adj f v x) = f ((u:B)*(v:B))*x*f ((↑v⁻¹:B)*(↑u⁻¹:B)) := by
  change f (u:B)*(f (v:B)*x*f (↑v⁻¹:B))*f (↑u⁻¹:B) = _
  simp only [map_mul,mul_assoc]

private theorem adj_on_image (f : B →ₐ[ℚ] D) (u : Bˣ) (x : B) :
    adj f u (f x) = f ((u:B)*x*(↑u⁻¹:B)) := by
  change f (u:B)*f x*f (↑u⁻¹:B) = _
  rw [map_mul,map_mul]

private theorem adj_sq (f : B →ₐ[ℚ] D) (u : Bˣ) (t s : ℚ)
    (ht : (u:B)*(u:B) = algebraMap ℚ B t) (hs : (↑u⁻¹:B)*(↑u⁻¹:B) = algebraMap ℚ B s)
    (hts : t*s=1) (x : D) : adj f u (adj f u x) = x := by
  rw [adj_comp_apply,ht,hs,AlgHom.commutes,AlgHom.commutes,Algebra.commutes t x,
    mul_assoc,←map_mul,hts,map_one,mul_one]

private theorem adj_comm (f : B →ₐ[ℚ] D) (x : D) :
    adj f unitI (adj f unitJ x) = adj f unitJ (adj f unitI x) := by
  have h : (unitI:B)*(unitJ:B) = -((unitJ:B)*(unitI:B)) := by
    ext <;> norm_num [unitI,unitJ]
  have k : (↑unitJ⁻¹:B)*(↑unitI⁻¹:B) = -((↑unitI⁻¹:B)*(↑unitJ⁻¹:B)) := by
    ext <;> norm_num [unitI,unitJ]
  simp only [adj_comp_apply,h,k,map_neg,neg_mul,mul_neg,neg_neg]

private theorem split_fixed (S T : Subalgebra ℚ D) (g : D →ₐ[ℚ] D)
    (gg : ∀ x, g (g x) = x) (u : Dˣ) (gu : g (u:D) = -(u:D))
    (uT : (u:D) ∈ T) (invS : (↑u⁻¹:D) ∈ S) (stable : ∀ x ∈ T, g x ∈ T)
    (fixed : ∀ x ∈ T, g x = x → x ∈ S) : T ≤ S := by
  intro x hx
  have hg := stable x hx
  have pos := fixed (x+g x) (T.add_mem hx hg) (by rw [map_add,gg,add_comm])
  have neg := fixed ((x-g x)*(u:D)) (T.mul_mem (T.sub_mem hx hg) uT)
    (by rw [map_mul,map_sub,gg,gu]; noncomm_ring)
  have diff : x-g x ∈ S := by simpa [mul_assoc] using S.mul_mem neg invS
  have two : (2:ℚ) • x ∈ S := by
    rw [two_smul]
    convert S.add_mem pos diff using 1
    abel
  have half := S.toSubmodule.smul_mem (1/2:ℚ) two
  change (1/2:ℚ) • ((2:ℚ) • x) ∈ S at half
  simpa only [smul_smul,show (1/2:ℚ)*2 = 1 by norm_num,one_smul] using half

private theorem commutes_of_fixed (f : B →ₐ[ℚ] D) (u : Bˣ) (x : D) (hx : adj f u x = x) :
    f (u:B)*x = x*f (u:B) := by
  change f (u:B)*x*f (↑u⁻¹:B)=x at hx
  have e := congrArg (fun z => z*f (u:B)) hx
  simpa only [mul_assoc,←map_mul,Units.inv_mul,map_one,mul_one] using e

/-- Every rational algebra carrying the quaternion action is generated
by that action and its common centralizer at i and j. -/
theorem quaternion_centralizer_generates (f : B →ₐ[ℚ] D) (S : Subalgebra ℚ D)
    (image : ∀ b, f b ∈ S)
    (central : ∀ x : D, f (unitI:B)*x=x*f (unitI:B) → f (unitJ:B)*x=x*f (unitJ:B) → x∈S) :
    ∀ x : D, x ∈ S := by
  let fixedI := AlgHom.equalizer (adj f unitI) (AlgHom.id ℚ D)
  let uI : Dˣ := Units.map f.toRingHom.toMonoidHom unitI
  let uJ : Dˣ := Units.map f.toRingHom.toMonoidHom unitJ
  have ai := adj_sq f unitI 2 (1/2) (by ext <;> norm_num [unitI,QuaternionAlgebra.algebraMap_eq])
    (by ext <;> norm_num [unitI,QuaternionAlgebra.algebraMap_eq]) (by norm_num)
  have aj := adj_sq f unitJ (-3) (-1/3) (by ext <;> norm_num [unitJ,QuaternionAlgebra.algebraMap_eq])
    (by ext <;> norm_num [unitJ,QuaternionAlgebra.algebraMap_eq]) (by norm_num)
  have negI : adj f unitJ (uI:D) = -(uI:D) := by
    change adj f unitJ (f (unitI:B)) = -f _
    rw [adj_on_image,←map_neg]
    congr 1
    ext <;> norm_num [unitI,unitJ]
  have negJ : adj f unitI (uJ:D) = -(uJ:D) := by
    change adj f unitI (f (unitJ:B)) = -f _
    rw [adj_on_image,←map_neg]
    congr 1
    ext <;> norm_num [unitI,unitJ]
  have allI : fixedI ≤ S := by
    apply split_fixed S fixedI (adj f unitJ) aj uI negI
    · change adj f unitI (f (unitI:B)) = f (unitI:B)
      rw [adj_on_image,mul_assoc,Units.mul_inv,mul_one]
    · exact image (↑unitI⁻¹:B)
    · intro x hx
      change adj f unitI x = x at hx
      change adj f unitI (adj f unitJ x) = adj f unitJ x
      rw [adj_comm,hx]
    · intro x hx hy
      exact central x (commutes_of_fixed f unitI x hx) (commutes_of_fixed f unitJ x hy)
  have all : (⊤ : Subalgebra ℚ D) ≤ S :=
    split_fixed S ⊤ (adj f unitI) ai uJ negJ (by simp) (image (↑unitJ⁻¹:B))
      (by intros; simp) (fun _ _ hx => allI hx)
  exact fun x => all (by trivial : x ∈ (⊤ : Subalgebra ℚ D))

/-- A scalar common centralizer forces the specified rational action to be onto. -/
theorem rational_action_surjective_of_scalar_centralizer (f : B →ₐ[ℚ] D)
    (central : ∀ x : D, f (unitI:B)*x=x*f (unitI:B) → f (unitJ:B)*x=x*f (unitJ:B) →
      ∃ a : ℚ, x = algebraMap ℚ D a) : Function.Surjective f := by
  apply quaternion_centralizer_generates f f.range (fun b => ⟨b,rfl⟩)
  intro x hi hj
  obtain ⟨a,rfl⟩ := central x hi hj
  exact ⟨algebraMap ℚ B a,f.commutes a⟩

private theorem commutes_image (f : B →ₐ[ℚ] D) (x : D)
    (hi : f (unitI:B)*x=x*f (unitI:B)) (hj : f (unitJ:B)*x=x*f (unitJ:B)) (q : B) :
    f q*x=x*f q := by
  have basis : q.re • (1:B) + q.imI • (unitI:B) + q.imJ • (unitJ:B) +
      q.imK • ((unitI:B)*(unitJ:B)) = q := by
    ext <;> simp [unitI,unitJ]
  have hk : (f (unitI:B)*f (unitJ:B))*x=x*(f (unitI:B)*f (unitJ:B)) := by
    rw [mul_assoc,hj,←mul_assoc,hi,mul_assoc]
  rw [←basis]
  simp only [map_add,map_smul,map_mul,map_one,add_mul,mul_add,Algebra.smul_mul_assoc,
    Algebra.mul_smul_comm,one_mul,mul_one,hi,hj,hk]

private def commutingWith (x : D) : Subalgebra ℚ D where
  carrier := {y | x*y=y*x}
  add_mem' {a b} ha hb := by
    change x*a=a*x at ha
    change x*b=b*x at hb
    change x*(a+b)=(a+b)*x
    rw [mul_add,add_mul,ha,hb]
  mul_mem' {a b} ha hb := by
    change x*a=a*x at ha
    change x*b=b*x at hb
    change x*(a*b)=(a*b)*x
    rw [←mul_assoc,ha,mul_assoc,hb,mul_assoc]
  algebraMap_mem' a := (Algebra.commutes a x).symm

/-- If the common centralizer of the two quaternionic generators is
commutative, it is exactly the centre of the full algebra. -/
theorem centralizes_whole_of_commutative_centralizer (f : B →ₐ[ℚ] D)
    (comm : ∀ (x y : D), f (unitI:B)*x=x*f (unitI:B) → f (unitJ:B)*x=x*f (unitJ:B) →
      f (unitI:B)*y=y*f (unitI:B) → f (unitJ:B)*y=y*f (unitJ:B) → x*y=y*x)
    (x : D) (hi : f (unitI:B)*x=x*f (unitI:B)) (hj : f (unitJ:B)*x=x*f (unitJ:B)) :
    ∀ y : D, x*y=y*x :=
  quaternion_centralizer_generates f (commutingWith x)
    (fun b => (commutes_image f x hi hj b).symm) (fun y => comm x y hi hj)

/-- For an algebra with a commutative quaternionic centralizer, a scalar
centre forces the entire algebra to be the prescribed quaternion algebra. -/
theorem rational_action_surjective_of_scalar_center (f : B →ₐ[ℚ] D)
    (comm : ∀ (x y : D), f (unitI:B)*x=x*f (unitI:B) → f (unitJ:B)*x=x*f (unitJ:B) →
      f (unitI:B)*y=y*f (unitI:B) → f (unitJ:B)*y=y*f (unitJ:B) → x*y=y*x)
    (center : ∀ x : D, (∀ y : D, x*y=y*x) → ∃ a : ℚ, x = algebraMap ℚ D a) :
    Function.Surjective f :=
  rational_action_surjective_of_scalar_centralizer f fun x hi hj =>
    center x (centralizes_whole_of_commutative_centralizer f comm x hi hj)

end
end ZInQBlueprint.LevelThree.IntegralOrder
#print axioms ZInQBlueprint.LevelThree.IntegralOrder.quaternion_centralizer_generates
#print axioms ZInQBlueprint.LevelThree.IntegralOrder.rational_action_surjective_of_scalar_centralizer
#print axioms ZInQBlueprint.LevelThree.IntegralOrder.centralizes_whole_of_commutative_centralizer
#print axioms ZInQBlueprint.LevelThree.IntegralOrder.rational_action_surjective_of_scalar_center
