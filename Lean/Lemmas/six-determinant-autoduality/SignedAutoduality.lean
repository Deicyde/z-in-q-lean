import SignedDeterminantEvaluation

/-! Autoduality over the algebraic closure as generation by the Poincaré restrictions. -/
open CategoryTheory AlgebraicGeometry MonoidalCategory
open scoped CategoryTheory.MonObj ZInQBlueprint.NormalDescent
namespace ZInQBlueprint.DeterminantAutoduality
open CanonicalTheta SixAbelMap GeometricMarking QuaternionMarking NormalDescent AbelianModel ThetaClass
noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 2000000
variable {u : ℚ} (hu : u ∉ ZInQ.contactSet)
local notation "J" => geometricJacobian hu

def signedPolarization : sections J →+ Additive (PicUnits (geometricJacobian hu).X.left) :=
  polarization (A:=J) (isAbelianScheme_baseChange (algebraMap ℚ Qbar) (SixJacobian.isAbelian hu))
    (signedThetaLine hu) (signedThetaLine_invertible hu)

def evaluationClass (p : FibrePoints u) : Additive (PicUnits (geometricJacobian hu).X.left) :=
  Additive.ofMul (lineClass (signedEvaluation hu p) (signedEvaluation_invertible hu p))

/-- Moret-Bailly 2.7.6 with the convention Tₓ(y)=y+x. -/
theorem polarization_at_abel (p : FibrePoints u) :
    signedPolarization hu ((rigidDivisors hu).abel p) = - evaluationClass hu p := by
  let L := signedThetaLine hu
  let a := (rigidDivisors hu).abel p
  let U := signedEvaluation hu p
  let hL := signedThetaLine_invertible hu
  let hU := signedEvaluation_invertible hu p
  have eqn := (lineClass_eq ((hL.pullback (SixThetaRestriction.translation a).hom.left).tensor hU) hL).mpr
    (signed_evaluation_formula hu p)
  rw [lineClass_tensor] at eqn
  change translatedClass L hL a * lineClass U hU = lineClass L hL at eqn
  change translatedClass L hL a / lineClass L hL = (lineClass U hU)⁻¹
  rw [←eqn,div_mul_eq_div_div]
  simp

/-- The image of the signed determinant homomorphism is computed by fixed-curve evaluations. -/
theorem range_eq_poincare : (signedPolarization hu).range =
    AddSubgroup.closure (Set.range (evaluationClass hu)) := by
  let φ := signedPolarization hu
  let S := AddSubgroup.closure (Set.range (evaluationClass hu))
  have hgen : ∀ p, φ ((rigidDivisors hu).abel p) ∈ S := fun p => by
    rw [show φ ((rigidDivisors hu).abel p) = -evaluationClass hu p from polarization_at_abel hu p]
    exact S.neg_mem (AddSubgroup.subset_closure ⟨p,rfl⟩)
  apply le_antisymm
  · rintro _ ⟨x,rfl⟩
    have hx : x ∈ AddSubgroup.closure (Set.range (fun r : FibrePoints u × FibrePoints u =>
        (rigidDivisors hu).abel r.1 - (rigidDivisors hu).abel r.2)) := by
      rw [(rigidDivisors hu).generate]
      exact AddSubgroup.mem_top _
    change φ x ∈ S
    induction hx using AddSubgroup.closure_induction with
    | mem z hz => obtain ⟨⟨a,b⟩,rfl⟩ := hz; rw [map_sub]; exact S.sub_mem (hgen a) (hgen b)
    | zero => rw [map_zero]; exact S.zero_mem
    | add a b _ _ ha hb => rw [map_add]; exact S.add_mem ha hb
    | neg a _ ha => rw [map_neg]; exact S.neg_mem ha
  · apply (AddSubgroup.closure_le _).mpr
    rintro _ ⟨p,rfl⟩
    refine ⟨-((rigidDivisors hu).abel p),?_⟩
    rw [map_neg,polarization_at_abel,neg_neg]

/-- On the Jacobian, all algebraically trivial lines are generated by the restrictions
of its normalized Poincaré family to individual points of the curve. -/
def PoincareGenerates : Prop :=
  ∀ N : (geometricJacobian hu).X.left.Modules, ∀ hN : N.IsInvertible,
    RelPicard.IsAlgEquivZero (geometricJacobian hu).X.hom N →
      Additive.ofMul (lineClass N hN) ∈ AddSubgroup.closure (Set.range (evaluationClass hu))

theorem signed_principal_iff : PrincipalTranslations (A:=J) (signedThetaLine hu) ↔ PoincareGenerates hu := by
  rw [principal_iff_classes (isAbelianScheme_baseChange (algebraMap ℚ Qbar) (SixJacobian.isAbelian hu)) _
    (signedThetaLine_invertible hu)]
  change (∀ N, ∀ hN : N.IsInvertible, RelPicard.IsAlgEquivZero (geometricJacobian hu).X.hom N →
    Additive.ofMul (lineClass N hN) ∈ (signedPolarization hu).range) ↔ _
  rw [range_eq_poincare]
  rfl

end
end ZInQBlueprint.DeterminantAutoduality
#print axioms ZInQBlueprint.DeterminantAutoduality.signedPolarization
#print axioms ZInQBlueprint.DeterminantAutoduality.polarization_at_abel
#print axioms ZInQBlueprint.DeterminantAutoduality.range_eq_poincare
#print axioms ZInQBlueprint.DeterminantAutoduality.signed_principal_iff
