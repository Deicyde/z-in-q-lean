import WeightedPointSigns

/-! Maps of the degree-zero Picard group can be tested on differences of two
geometric points. The two points above a base point give linearly equivalent
degree-two divisors on different fibres of the hyperelliptic projection. -/
namespace ZInQBlueprint.MarkedForm
open CurveChart
noncomputable section
variable {K : Type*} [Field K] [CharZero K]

def identityLift (u : ℚ) (δ : K) : Lift u δ :=
  ⟨LinearEquiv.refl K _,1,fun p => by simp⟩

def hyperellipticLift (u : ℚ) (δ : K) : Lift u δ :=
  ⟨LinearEquiv.refl K _, -1,fun p => by simp⟩

theorem identityLift_action (u : ℚ) (δ : K) :
    (identityLift u δ).action=Equiv.refl _ := by
  apply Equiv.ext
  intro p
  induction p using Quotient.inductionOn with
  | _ p =>
    obtain ⟨q,hq,hb,hy⟩ := coordinateEquiv_coordinates (identityLift u δ).lin
      (identityLift u δ).unitY (identityLift u δ).equation p
    change coordinateEquiv _ _ _ _=Quotient.mk _ p
    rw [hq]
    apply congrArg (Quotient.mk _)
    apply Rep.ext
    · exact hb
    · simpa [identityLift] using hy

theorem hyperellipticLift_action (u : ℚ) (δ : K) :
    (hyperellipticLift u δ).action=negY (paperForm u δ) := rfl

/-- Equality of all degree-two fibres makes the involution act by minus one on
each class of a difference of two curve points. -/
theorem opposite_differences {P G : Type*} [AddCommGroup G] (i : P → P) (j : P → G)
    (fibres : ∀ p q, j p+j (i p)=j q+j (i q)) (p q : P) :
    j (i p)-j (i q)= -(j p-j q) := by
  have h := fibres p q
  calc j (i p)-j (i q) = (j p+j (i p))-(j q+j (i q))-(j p-j q) := by abel
       _ = _ := by rw [h,sub_self,zero_sub]

/-- The image of the degree-zero divisor group is generated by pair differences.
Under this generation condition the sign on the whole group follows from its
action on curve points; no assumption about the order of the map is needed. -/
theorem picard_action_sign [Infinite K] {u : ℚ} (hu : u∉ZInQ.contactSet)
    {δ : K} (hd : δ≠0) {G : Type*} [AddCommGroup G]
    (j : Points (paperForm u δ) → G)
    (gen : AddSubgroup.closure (Set.range (fun p : Points (paperForm u δ) ×
        Points (paperForm u δ) => j p.1-j p.2))=⊤)
    (fibres : ∀ p q, j p+j (negY (paperForm u δ) p)=j q+j (negY (paperForm u δ) q))
    (f : G →+ G) (t : Lift u δ)
    (act : ∀ p q, f (j p-j q)=j (t.action p)-j (t.action q)) :
    f=AddMonoidHom.id G ∨ f= -(AddMonoidHom.id G) := by
  have dext (g h : G →+ G) (hs : ∀ p q, g (j p-j q)=h (j p-j q)) : g=h := by
    ext x
    have hx : x ∈ AddSubgroup.closure (Set.range (fun p : Points (paperForm u δ) ×
        Points (paperForm u δ) => j p.1-j p.2)) := by rw [gen]; exact AddSubgroup.mem_top x
    induction hx using AddSubgroup.closure_induction with
    | mem _ h => obtain ⟨⟨p,q⟩,rfl⟩ := h; exact hs p q
    | zero => simp
    | add _ _ _ _ hx hy => simp [map_add,hx,hy]
    | neg _ _ hx => simp [map_neg,hx]
  rcases lift_action_sign hu hd t with e|e
  · left
    apply dext
    simp only [e,Equiv.refl_apply] at act
    exact act
  · right
    apply dext
    intro p q
    rw [act,e]
    exact opposite_differences _ j fibres p q

end
end ZInQBlueprint.MarkedForm
#print axioms ZInQBlueprint.MarkedForm.identityLift_action
#print axioms ZInQBlueprint.MarkedForm.hyperellipticLift_action
#print axioms ZInQBlueprint.MarkedForm.opposite_differences
#print axioms ZInQBlueprint.MarkedForm.picard_action_sign
