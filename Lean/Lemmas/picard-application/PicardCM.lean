import PrymFactor
import PicardLocalization
import Mathlib.Data.Finset.Preimage
import Mathlib.FieldTheory.IntermediateField.Algebraic

/-!
# The marked invariant and the geometric Picard fibre

Laga–Shnidman, equation (2.3), Remark 2.12 and Lemma 6.16,
https://doi.org/10.1112/jlms.70347.  The exceptional parameters below form
one finite set for every nonzero quadratic twist.
-/

namespace ZOverQ.Qualitative.PicardCM
open Polynomial IntermediateField PicardConjugation PicardLocalization PicardDescent PicardLocal
open ZInQ ZInQ.QualitativeHeight CategoryTheory AlgebraicGeometry ZInQBlueprint.AbelianModel
noncomputable section

/-- The marked invariant in the algebraic closure of the rationals. -/
def markedValue (s : ℚ) : Qbar :=
  ((s:Qbar)+(ρ:Qbar))^6/((s:Qbar)-(ρ:Qbar))^6

theorem value_eq (s : ℚ) : markedValue s = fixedField.val (U s / V s) := by
  simp [markedValue,U,V]

private theorem rho_square : (ρ:Qbar)^2 = -3 := by
  change (fixedField.val ρ)^2 = _
  rw [← map_pow,rho_sq,map_neg,map_ofNat]

private theorem denominator {K : Type*} [Field K] [CharZero K] {r : K} (hr : r^2 = -3) (s : ℚ) :
    (s:K)-r ≠ 0 := by
  intro e
  rw [← sub_eq_zero.mp e] at hr
  have h : s^2 = (-3:ℚ) := by exact_mod_cast hr
  nlinarith [sq_nonneg s]

/-- The invariant belongs to the fixed quadratic subfield generated by
the marked square root. -/
theorem quadratic_field (s : ℚ) :
    markedValue s ∈ ℚ⟮(ρ:Qbar)⟯ ∧ Module.finrank ℚ ℚ⟮(ρ:Qbar)⟯ = 2 := by
  let k := ℚ⟮(ρ:Qbar)⟯
  have hρ : (ρ:Qbar) ∈ k := mem_adjoin_simple_self ℚ (ρ:Qbar)
  have hs : (s:Qbar) ∈ k := k.algebraMap_mem s
  refine ⟨k.div_mem (_root_.pow_mem (k.add_mem hs hρ) 6) (_root_.pow_mem (k.sub_mem hs hρ) 6),?_⟩
  let P : ℚ[X] := X^2+C 3
  have deg : P.natDegree = 2 := by dsimp [P]; compute_degree!
  have irr : Irreducible P := irreducible_of_degree_le_three_of_not_isRoot (by rw [deg]; decide) (by
    intro x hx
    have t : x^2+3=0 := by simpa [P,IsRoot] using hx
    nlinarith [sq_nonneg x])
  have mp : minpoly ℚ (ρ:Qbar) = P :=
    (minpoly.eq_of_irreducible_of_monic irr (by norm_num [P,rho_square])
      (monic_X_pow_add_C (3:ℚ) (by decide : 2≠0))).symm
  rw [adjoin.finrank (Algebra.IsIntegral.isIntegral (R:=ℚ) (ρ:Qbar)),mp,deg]

theorem degree_le_two (s : ℚ) : Module.finrank ℚ ℚ⟮markedValue s⟯ ≤ 2 := by
  obtain ⟨hj,deg⟩ := quadratic_field s
  let : FiniteDimensional ℚ ℚ⟮(ρ:Qbar)⟯ :=
    adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral (R:=ℚ) (ρ:Qbar))
  rw [← deg]
  exact IntermediateField.finrank_le_of_le_right (adjoin_simple_le_iff.mpr hj)

private theorem parameter_injective : Function.Injective picardParameter := by
  intro a b eqn
  have mul : (120:ℚ)*a⁻¹ = 120*b⁻¹ := by
    exact add_left_cancel (show 5+120*a⁻¹=5+120*b⁻¹ by simpa [picardParameter,div_eq_mul_inv] using eqn)
  exact inv_injective (mul_left_cancel₀ (by norm_num : (120:ℚ)≠0) mul)

/-- The pullback of a finite set of marked values along the *actual* rational
parameter map has at most six points for each marked value. The membership
equivalence includes the totalized rational value at zero. -/
theorem finite_pullback (f : ℚ → ℚ) (inj : Function.Injective f) (values : Finset Qbar) :
    ∃ T : Finset ℚ, T.card ≤ 6*values.card ∧ ∀ t, t∈T ↔ markedValue (f t) ∈ values := by
  classical
  let r : Qbar := ρ
  let P (j : Qbar) : Qbar[X] := (X+C r)^6-C j*(X-C r)^6
  have nr : r ≠ 0 := by
    intro h
    have h' : r^2 = -3 := rho_square
    rw [h] at h'; norm_num at h'
  have nonzero (j : Qbar) : P j ≠ 0 := by
    intro zero
    have test := congrArg (fun p : Qbar[X] => p.eval r) zero
    have h : r+r ≠ 0 := by rw [← two_mul]; exact mul_ne_zero (by norm_num) nr
    simp [P,h] at test
  have bound (j : Qbar) : (P j).roots.toFinset.card ≤ 6 := by
    apply (Multiset.toFinset_card_le _).trans
    apply (card_roots' _).trans
    exact (natDegree_sub_le _ _).trans (max_le (by simp) ((natDegree_C_mul_le _ _).trans (by simp)))
  let roots := values.biUnion fun j => (P j).roots.toFinset
  let cast : ℚ → Qbar := fun t => (f t : Qbar)
  have hc : Function.Injective cast := Rat.cast_injective.comp inj
  let T := roots.preimage cast hc.injOn
  refine ⟨T,?_,?_⟩
  · change (roots.preimage cast hc.injOn).card ≤ _
    rw [Finset.card_preimage]
    exact (Finset.card_filter_le ..).trans ((Finset.card_biUnion_le_card_mul values _ 6
      (fun j _ => bound j)).trans_eq (Nat.mul_comm ..))
  · intro t
    change _∈roots.preimage cast hc.injOn ↔ _
    rw [Finset.mem_preimage]
    have root (j : Qbar) : cast t ∈ (P j).roots.toFinset ↔ markedValue (f t) = j := by
      rw [Multiset.mem_toFinset,mem_roots (nonzero _)]
      have nz : (cast t-r)^6 ≠ 0 := pow_ne_zero 6 (denominator rho_square _)
      simp only [P,IsRoot,eval_sub,eval_pow,eval_add,eval_X,eval_C,eval_mul,sub_eq_zero]
      exact (div_eq_iff nz).symm
    constructor
    · intro ht
      obtain ⟨j,hj,hit⟩ := Finset.mem_biUnion.mp ht
      exact (root j |>.mp hit) ▸ hj
    · intro ht
      exact Finset.mem_biUnion.mpr ⟨_,ht,(root _).mpr rfl⟩

/-- Apply the degree-two case of Laga–Shnidman Lemma 6.16. This uses
the ordinary field degree of the marked value on the coarse Picard line. -/
theorem cm_parameters (CM : Set Qbar)
    (finiteness : {j : Qbar | j ∈ CM ∧ Module.finrank ℚ ℚ⟮j⟯ ≤ 2}.Finite) :
    ∃ T : Finset ℚ, T.card ≤ 6*finiteness.toFinset.card ∧
      ∀ t, t ∈ T ↔ markedValue (picardParameter t) ∈ CM := by
  classical
  obtain ⟨T,cap,cut⟩ := finite_pullback picardParameter parameter_injective finiteness.toFinset
  exact ⟨T,cap,fun t => by rw [cut,Set.Finite.mem_toFinset]; exact and_iff_left (degree_le_two _)⟩

/-- The ordinary affine genus-two equation is y² = (1/2)f_{j,1}(x). -/
def canonicalPolynomial (j : Qbar) : Qbar[X] := C (1/2) * sextic j 1

/-- Over the algebraic closure, the canonical equation is exactly the
genus-two curve in Laga–Shnidman Remark 2.12 at marked invariant j. -/
theorem published_equation {j : Qbar} (hj : j ≠ 1) :
    ∃ a w : Qbar, 1-a^2/(4*w^3)=j ∧ ∀ x y,
      Prym.prymequation a w x y ↔ y^2 = (canonicalPolynomial j).eval x := by
  obtain ⟨u,hu⟩ := IsAlgClosed.exists_pow_nat_eq j (by decide : 0<6)
  have reg : u^6-(1:Qbar)^6 ≠ 0 := by simpa [hu] using sub_ne_zero.mpr hj
  refine ⟨Prym.a u 1,Prym.cubeRoot u 1,?_,?_⟩
  · simpa [hu] using Prym.moduli_parameter (u:=u) (v:=1) one_ne_zero reg
  intro x y
  rw [Prym.equation_iff reg]
  simp only [one_mul,one_pow,hu,canonicalPolynomial,eval_mul,eval_C]
  constructor
  · intro h; linear_combination h/2
  · intro h; linear_combination 2*h

/-- Smooth rational parameters give nonzero, distinct coefficients in the
unnormalized model. -/
theorem regular (t : ℚ) (ht : t ∉ contactSet) :
    let s := picardParameter t
    U s ≠ 0 ∧ V s ≠ 0 ∧ U s-V s ≠ 0 := by
  let s := picardParameter t
  have ht₀ : t ≠ 0 := by rintro rfl; exact ht (by decide)
  have non : ρ ≠ 0 := by
    intro hz
    have h := rho_sq
    rw [hz] at h; norm_num at h
  have branch : branchForm s 1 ≠ 0 := by
    have h := branchForm_change ht₀ 1
    rw [mul_one] at h
    rw [show branchForm s 1 = _ from h]
    exact mul_ne_zero (pow_ne_zero _ (div_ne_zero one_ne_zero ht₀))
      (mul_ne_zero (by norm_num) (Mult.contactPoly_ne_zero ht))
  have eqn : U s-V s = 12*ρ*((branchForm s 1:ℚ):fixedField) := by
    rw [show U s-V s = _ from Picard.sixth_difference (s:fixedField) ρ rho_sq]
    simp [branchForm]
  refine ⟨pow_ne_zero 6 ?_,pow_ne_zero 6 (denominator rho_sq s),?_⟩
  · simpa only [sub_neg_eq_add] using denominator (show (-ρ)^2 = -3 by simpa using rho_sq) s
  · rw [eqn]
    exact mul_ne_zero (mul_ne_zero (by norm_num) non) (Rat.cast_ne_zero.mpr branch)

/-- At a noncontact parameter the polynomial model uses precisely the invariant
given by the marked Picard-curve equation (2.3). -/
theorem actual_moduli_parameter (t : ℚ) (ht : t ∉ contactSet) :
    let s := picardParameter t
    let u : fixedField := (s:fixedField)+ρ
    let v : fixedField := (s:fixedField)-ρ
    fixedField.val (1-(Prym.a u v)^2/(4*(Prym.cubeRoot u v)^3)) = markedValue s := by
  dsimp only
  rw [Prym.moduli_parameter (denominator rho_sq _) (regular t ht).2.2]
  exact (value_eq _).symm

/-- The twisted Jacobian over the algebraic closure. -/
def geometricFibre (t d : ℚ) (ht : t ∉ contactSet) (hd : d ≠ 0) : GroupScheme Qbar :=
  (baseChange fixedField.val.toRingHom).obj
    (familyJacobian t d ht hd (AlgEquiv.refl : fixedField ≃ₐ[ℚ] fixedField))

/-- All the quadratic twists of the actual Jacobian at t identify over the
algebraic closure with the Jacobian of the one canonical equation at j(t). -/
theorem geometric_fibre_iso (t d : ℚ) (ht : t ∉ contactSet) (hd : d ≠ 0) :
    let g := canonicalPolynomial (markedValue (picardParameter t))
    ∃ (dg : g.natDegree = 6) (sg : g.Separable),
      Nonempty (geometricFibre t d ht hd ≅ completionJacobian g dg sg) := by
  let s := picardParameter t
  let u := U s/(2*(d:fixedField))
  let v := V s/(2*(d:fixedField))
  let j := markedValue s
  let φ := fixedField.val.toRingHom
  have eqj : j = φ (U s)/φ (V s) := (value_eq s).trans (_root_.map_div₀ φ _ _)
  have cast_div (x : fixedField) : φ (x/(2*(d:fixedField))) = φ x/(2*(d:Qbar)) := by
    rw [_root_.map_div₀, _root_.map_mul, map_ofNat, map_ratCast]
  obtain ⟨hu,hv,hΔ⟩ := regular t ht
  have v₀ : φ (V s) ≠ 0 := (map_ne_zero_iff _ φ.injective).mpr hv
  have d₀ : (d:Qbar) ≠ 0 := Rat.cast_ne_zero.mpr hd
  have c₀ : 2*(d:fixedField) ≠ 0 := mul_ne_zero (by norm_num) (Rat.cast_ne_zero.mpr hd)
  have hD : u-v ≠ 0 := by
    dsimp only [u,v]
    rw [← sub_div]; exact div_ne_zero hΔ c₀
  obtain ⟨w,hw⟩ := IsAlgClosed.exists_pow_nat_eq ((d:Qbar)/φ (V s)) (by decide : 0<2)
  have wn : w ≠ 0 := fun h => (div_ne_zero d₀ v₀) (by simpa [h] using hw.symm)
  have scl : canonicalPolynomial j = C (w^2)*(sextic u v).map φ := by
    rw [canonicalPolynomial,sextic_map,← LocalSupport.sextic_scale,← LocalSupport.sextic_scale]
    apply congrArg₂ sextic
    · change (1/2 : Qbar)*j = w^2 * φ (U s/(2*(d:fixedField)))
      rw [hw,eqj,cast_div]
      field_simp
    · change (1/2 : Qbar)*1 = w^2 * φ (V s/(2*(d:fixedField)))
      rw [hw,cast_div]
      field_simp
  obtain ⟨dg,sg,⟨i⟩⟩ := jacobian_scalar_square φ u v (div_ne_zero hu c₀)
    (div_ne_zero hv c₀) hD _ w wn scl
  refine ⟨dg,sg,⟨?_ ≪≫ i⟩⟩
  apply (baseChange φ).mapIso
  apply eqToIso
  unfold familyJacobian
  rfl

/-- An elliptic abelian subvariety is a closed one-dimensional abelian
subgroup. This predicate is evaluated after extension to the algebraic closure. -/
def HasEllipticSubgroup (A : GroupScheme Qbar) : Prop :=
  ∃ (E : GroupScheme Qbar), IsAbelianScheme E ∧ SmoothOfRelativeDimension 1 E.X.hom ∧
    ∃ f : E ⟶ A, IsClosedImmersion f.hom.hom.hom.left

private theorem subgroup_of_iso {A B : GroupScheme Qbar} (i : A ≅ B) :
    HasEllipticSubgroup A → HasEllipticSubgroup B := by
  rintro ⟨E,abel,dim,f,closed⟩
  let : IsClosedImmersion f.hom.hom.hom.left := closed
  let : IsIso i.hom.hom.hom.hom.left := ⟨⟨i.inv.hom.hom.hom.left,
    congrArg (fun g : A ⟶ A => g.hom.hom.hom.left) i.hom_inv_id,
    congrArg (fun g : B ⟶ B => g.hom.hom.hom.left) i.inv_hom_id⟩⟩
  exact ⟨E,abel,dim,f ≫ i.hom,show IsClosedImmersion (f.hom.hom.hom.left ≫ i.hom.hom.hom.hom.left)
      from inferInstance⟩

/-- Marked values for which the smooth canonical Jacobian contains an
elliptic abelian subvariety. -/
def splitValues : Set Qbar := {j | ∃ (dg : (canonicalPolynomial j).natDegree = 6)
    (sg : (canonicalPolynomial j).Separable), HasEllipticSubgroup (completionJacobian _ dg sg)}

/-- The degree-two finiteness for the canonical Jacobians is the consequence of
Laga–Shnidman Remark 2.12 and Lemmas 6.2 and 6.16, using simplicity up to
isogeny and the model in `published_equation`. The pullback and the comparison
with every actual twisted fibre are proved here. -/
theorem nonsimple_fibres
    (finite : {j : Qbar | j ∈ splitValues ∧ Module.finrank ℚ ℚ⟮j⟯ ≤ 2}.Finite) :
    ∃ T : Finset ℚ, T.card ≤ 6*finite.toFinset.card ∧
      ∀ (t d : ℚ) (ht : t ∉ contactSet) (hd : d ≠ 0),
        t ∈ T ↔ HasEllipticSubgroup (geometricFibre t d ht hd) := by
  obtain ⟨T,cap,cut⟩ := cm_parameters splitValues finite
  refine ⟨T,cap,?_⟩
  intro t d ht hd
  rw [cut]
  obtain ⟨dg,sg,⟨i⟩⟩ := geometric_fibre_iso t d ht hd
  exact ⟨fun ⟨_,_,h⟩ => subgroup_of_iso i.symm h,fun h => ⟨dg,sg,subgroup_of_iso i h⟩⟩

end
