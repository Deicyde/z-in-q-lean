import GuitartDescent
import Mathlib.NumberTheory.Cyclotomic.PrimitiveRoots
import Mathlib.Tactic

/-!
# Quadratic subfields of the discriminant-six quaternion algebra

If minus three is a square in the coefficient field, the square of a linear
combination of the quaternion generators `j` and `i*j` represents any chosen
central scalar. A number field has a nonsquare since the degrees of the fields
generated by primitive roots of unity of order a power of two are unbounded.
-/

namespace ZOverQ.Qualitative.GeneralQuaternionField
open Polynomial
noncomputable section

/-- A number field cannot contain all iterated square roots of minus one. -/
theorem exists_nonsquare (E : Type*) [Field E] [NumberField E] : ∃ a : E, ¬ IsSquare a := by
  by_contra! all
  have step (n : ℕ) : ∃ x : E, x^(2^n) = -1 := by
    induction n with
    | zero => exact ⟨-1,by simp⟩
    | succ n ih =>
      obtain ⟨x,hx⟩ := ih
      obtain ⟨y,hy⟩ := all x
      refine ⟨y,?_⟩
      rw [pow_succ',pow_mul, sq, ← hy, hx]
  let n := Module.finrank ℚ E
  obtain ⟨x,hx⟩ := step n
  have pos : 0 < 2^(n+1) := by positivity
  have prim : IsPrimitiveRoot x (2^(n+1)) := by
    apply (isRoot_cyclotomic_iff_charZero pos).mp
    rw [cyclotomic_prime_pow_eq_geom_sum Nat.prime_two]
    simp [IsRoot,Finset.sum_range_succ,hx]
  have hi : Irreducible (cyclotomic (Nat.lcm (2^(n+1)) (2^(n+1))) ℚ) := by
    simpa only [Nat.lcm_self] using cyclotomic.irreducible_rat pos
  have bound := IsPrimitiveRoot.lcm_totient_le_finrank prim prim hi
  simp only [Nat.lcm_self,Nat.totient_prime_pow_succ Nat.prime_two,Nat.reduceSub,mul_one] at bound
  exact (Nat.not_le_of_gt (Nat.lt_pow_self (n:=n) (a:=2) (by decide))) bound

section Algebra
variable {E A : Type*} [Field E] [CharZero E] [Ring A] [Algebra E A]

/-- If `r² = -3`, the pure quaternion form on the plane spanned by `j` and
`i*j` factors as `2(b+rc)(b-rc)` and represents every element of the base field. -/
theorem represents (i j : A) (hi : i^2 = -3) (hj : j^2 = 2) (skew : j*i = -(i*j))
    (r : E) (hr : r^2 = -3) (d : E) : ∃ u : A, u*u = algebraMap E A d := by
  have h₀ : r ≠ 0 := by rintro rfl; norm_num at hr
  let b := (1+d/2)/2
  let c := (1-d/2)/(2*r)
  have plus : b+r*c = 1 := by dsimp [b,c]; field_simp; ring
  have minus : b-r*c = d/2 := by dsimp [b,c]; field_simp; ring
  have scalar : b^2*2 + c^2*6 = d := calc
    _ = 2*(b+r*c)*(b-r*c) := by linear_combination 2*c^2*hr
    _ = d := by rw [plus,minus]; ring
  let k := i*j
  have hk : k*k = 6 := calc
    _ = i*(j*i)*j := by dsimp [k]; noncomm_ring
    _ = -(i^2*j^2) := by rw [skew]; noncomm_ring
    _ = 6 := by rw [hi,hj]; norm_num
  have cross : j*k + k*j = 0 := by
    dsimp only [k]
    rw [← mul_assoc j i j,skew,neg_mul,neg_add_cancel]
  refine ⟨b • j + c • k,?_⟩
  calc
    _ = (b*b) • (j*j) + (b*c) • (j*k+k*j) + (c*c) • (k*k) := by
      simp only [add_mul,mul_add,smul_mul_smul_comm,smul_add,mul_comm c b]
      abel
    _ = algebraMap E A (b^2*2+c^2*6) := by
      rw [←sq j,hj,hk,cross,smul_zero,add_zero]
      simp only [map_add,map_mul,map_ofNat,Algebra.smul_def,sq]
    _ = algebraMap E A d := congrArg (algebraMap E A) scalar

end Algebra

section NumberField
variable {E A : Type} [Field E] [NumberField E] [Ring A] [Algebra E A]

/-- A represented nonsquare exists for every degree of the number field. -/
theorem quadratic_element (i j : A) (hi : i^2 = -3) (hj : j^2 = 2) (skew : j*i = -(i*j)) :
    ∃ (d : E) (u : A), ¬IsSquare d ∧ u*u = algebraMap E A d := by
  by_cases h : IsSquare (-3 : E)
  · obtain ⟨r,hr⟩ := h
    obtain ⟨d,hd⟩ := exists_nonsquare E
    obtain ⟨u,hu⟩ := represents i j hi hj skew r (by simpa only [sq] using hr.symm) d
    exact ⟨d,u,hd,hu⟩
  · exact ⟨-3,i,h,by simpa only [map_neg,map_ofNat,←sq] using hi⟩

variable [Nontrivial A]

/-- A quadratic field over the given coefficient field embeds in the
endomorphism algebra. -/
theorem quadratic_extension (i j : A) (hi : i^2 = -3) (hj : j^2 = 2) (skew : j*i = -(i*j)) :
    ∃ (L : Type) (_ : Field L) (_ : Algebra E L), Module.finrank E L = 2 ∧
      ∃ f : L →ₐ[E] A, Function.Injective f := by
  obtain ⟨d,u,ns,hu⟩ := quadratic_element (E:=E) i j hi hj skew
  let : Fact (¬IsSquare d) := ⟨ns⟩
  let L := QuadraticAlgebra E d 0
  let f : L →ₐ[E] A := QuadraticAlgebra.lift ⟨u,by simpa [Algebra.smul_def] using hu⟩
  exact ⟨L,inferInstance,inferInstance,QuadraticAlgebra.finrank_eq_two d 0,f,f.injective⟩

/-- The rational endomorphism field has degree twice the coefficient degree. -/
theorem field_action [Algebra ℚ A] [IsScalarTower ℚ E A] (i j : A)
    (hi : i^2 = -3) (hj : j^2 = 2) (skew : j*i = -(i*j)) :
    ∃ (L : Type) (_ : Field L) (_ : NumberField L),
      Module.finrank ℚ L = 2*Module.finrank ℚ E ∧ Nonempty (L →ₐ[ℚ] A) := by
  obtain ⟨d,u,hd,hu⟩ := quadratic_element (E:=E) i j hi hj skew
  exact GuitartDescent.quadratic_field_action d hd u hu

end NumberField
end
end ZOverQ.Qualitative.GeneralQuaternionField

