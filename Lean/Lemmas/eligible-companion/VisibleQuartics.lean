import EllipticDescent

namespace CompanionDescent

/-- Clearing the common denominator of L and L±1 leaves three quartics in u. -/
theorem quartic_factors (u θ l : Rat) (param : (u^2-θ)*l=2*(u^2+θ)) :
    (u^2-θ)*(l-1)=u^2+3*θ ∧ (u^2-θ)*(l+1)=3*u^2+θ := by
  constructor <;> grobner

/-- Clearing a common square denominator preserves rational representation. -/
private theorem scale_square (x d c : Rat) (nd : d≠0) :
    (∃ w : Rat, x=c*w^2) ↔ ∃ y : Rat, d^2*x=c*y^2 := by
  constructor
  · rintro ⟨w,rfl⟩
    exact ⟨d*w,by grobner⟩
  · rintro ⟨y,h⟩
    have inv : d*d⁻¹=1 := by grind
    refine ⟨y*d⁻¹,?_⟩
    calc x = (d^2*x)*(d⁻¹)^2 := by grobner
         _ = _ := by rw [h]; grobner

/-- Exact equivalence for the three possible nonconstant negative abscissa
classes in the subgroup generated by the visible section and the 2-torsion. -/
theorem visible_classes_iff (β θ u l : Rat) (hd : u^2-θ≠0)
    (param : (u^2-θ)*l=2*(u^2+θ)) :
    ((∃ w : Rat, l^2-1=3*β*w^2) ∨
     (∃ w : Rat, l-1=β*w^2) ∨
     (∃ w : Rat, l+1=3*β*w^2)) ↔
    ((∃ y : Rat, (u^2+3*θ)*(3*u^2+θ)=3*β*y^2) ∨
     (∃ y : Rat, (u^2+3*θ)*(u^2-θ)=β*y^2) ∨
     (∃ y : Rat, (3*u^2+θ)*(u^2-θ)=3*β*y^2)) := by
  let d := u^2-θ
  obtain ⟨a,b⟩ := quartic_factors u θ l param
  change d*(l-1)=_ at a
  change d*(l+1)=_ at b
  have h₁ : d^2*(l^2-1)=(u^2+3*θ)*(3*u^2+θ) := by rw [←a,←b]; grobner
  have h₂ : d^2*(l-1)=(u^2+3*θ)*d := by rw [←a]; grobner
  have h₃ : d^2*(l+1)=(3*u^2+θ)*d := by rw [←b]; grobner
  exact or_congr ((scale_square _ d _ hd).trans (by rw [h₁]))
    (or_congr ((scale_square _ d _ hd).trans (by rw [h₂]))
              ((scale_square _ d _ hd).trans (by rw [h₃])))

/-- A nonzero square on any of the three quartics gives a point with the
required abscissa. The three points are a 2-torsion point and two translates
of the visible section by 2-torsion. -/
theorem visible_quartics (β θ u y : Rat) (hu : u≠0) (hy : y≠0) (hd : u^2-θ≠0)
    (hit :
      (u^2+3*θ)*(3*u^2+θ)=3*β*y^2 ∨
      (u^2+3*θ)*(u^2-θ)=β*y^2 ∨
      (3*u^2+θ)*(u^2-θ)=3*β*y^2) : EllipticFibre β θ := by
  let d := u^2-θ
  let l := 2*(u^2+θ)*d⁻¹
  let w := y*d⁻¹
  have inv : d*d⁻¹=1 := by dsimp [d]; grind
  have param : (u^2-θ)*l=2*(u^2+θ) := by change d*l=_; dsimp [l]; grobner
  obtain ⟨a,b⟩ := quartic_factors u θ l param
  change d*(l-1)=_ at a
  change d*(l+1)=_ at b
  have scaled : w*d=y := by dsimp [w]; grobner
  have nw : w≠0 := by intro z; apply hy; rw [z] at scaled; simpa using scaled.symm
  have cancel (x z : Rat) (h : x*d^2=z*d^2) : x=z := by
    calc x = (x*d^2)*(d⁻¹)^2 := by grobner
         _ = (z*d^2)*(d⁻¹)^2 := by rw [h]
         _ = z := by grobner
  rcases hit with h | h | h
  · rw [←a,←b,←scaled] at h
    refine ⟨u,l,1-l^2,0,w,hu,param,nw,cancel _ _ (by grobner),?_⟩
    unfold cubic; grobner
  · change (u^2+3*θ)*d=β*y^2 at h
    rw [←a,←scaled] at h
    refine ⟨u,l,-3*(l-1),3*(l-1)*(l-2),w,hu,param,nw,cancel _ _ (by grobner),?_⟩
    unfold cubic; grobner
  · change (3*u^2+θ)*d=3*β*y^2 at h
    rw [←b,←scaled] at h
    refine ⟨u,l,-(l+1),(l+1)*(l-2),w,hu,param,nw,cancel _ _ (by grobner),?_⟩
    unfold cubic; grobner

#print axioms quartic_factors
#print axioms visible_classes_iff
#print axioms visible_quartics

end CompanionDescent
